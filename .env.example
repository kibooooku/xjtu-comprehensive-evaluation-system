# Local server. Never commit .env or secrets/.
HOST=127.0.0.1
PORT=8000
DEMO_MODE=true
COOKIE_SECURE=false
# Optional secure production secret; otherwise instance/session.key is generated.
# SESSION_SECRET=replace-with-a-long-random-secret
# DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Recognize the complete confirmed material, up to 500 pages per item.
# Monthly API budgets and the provider's quota still stop further cloud calls.
OCR_MAX_ANALYSIS_PAGES=500
# TENCENTCLOUD_SECRET_ID=
# TENCENTCLOUD_SECRET_KEY=
# Account-side OCR postpaid must be disabled; local budgets are additional safeguards.
# Optional standalone MediaKit probe; also read from secrets/volcengine_mediakit.env.
# VOLCENGINE_MEDIAKIT_API_KEY=
