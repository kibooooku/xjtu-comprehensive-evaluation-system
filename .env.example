# Local server. Never commit .env or secrets/.
HOST=127.0.0.1
PORT=8000
DEMO_MODE=true
COOKIE_SECURE=false
# Optional secure production secret; otherwise instance/session.key is generated.
# SESSION_SECRET=replace-with-a-long-random-secret
# DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Upload allows 500 pages. Full-page cloud OCR allows up to 12 pages PER FILE.
# Longer scans use cloud OCR only on the first/last page for validity evidence;
# middle-page participation must be selected manually. Existing PDF text is local.
# SealOCR checks each file's first and last page (one-page deduped).
# This value can lower the 12-page limit; it cannot raise it.
OCR_MAX_ANALYSIS_PAGES=12
# TENCENTCLOUD_SECRET_ID=
# TENCENTCLOUD_SECRET_KEY=
# Account-side OCR postpaid must be disabled; local budgets are additional safeguards.
# Optional standalone MediaKit probe; also read from secrets/volcengine_mediakit.env.
# VOLCENGINE_MEDIAKIT_API_KEY=
