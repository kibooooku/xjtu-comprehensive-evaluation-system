          "type": "association",
          "fromMultiplicity": "0..*",
          "toMultiplicity": "1",
          "label": "本轮审核的冻结内容"
        },
        {
          "from": "ApplicationRevision",
          "to": "ApplicationAttachment",
          "type": "composition",
          "fromMultiplicity": "1",
