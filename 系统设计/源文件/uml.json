    {
      "id": "02-application-evidence-review",
      "name": "申请版本、证据与审核领域类图",
      "type": "class",
      "notes": [
        "Application保持稳定标识；ApplicationRevision保存内容；SubmissionRound拥有各次提审状态，三者不能合成一条可覆盖记录。",
        "工作稿修改形成新修订；正式提交冻结修订并创建新轮次。ReviewDecision、StateEvent和AwardSupersession绑定轮次及修订。",
        "每次正式提交至少一个附件；同文件内多次活动合成一个条目。有效性与参与证明可有多张、跨页截图。",
        "系统替代驳回与恢复写StateEvent(actorType=SYSTEM)，不伪装为学生审查员或辅导员的ReviewDecision。",
        "新高优先级申请正式提交立即替代旧项；失败只恢复该替代造成的旧轮次状态，不覆盖后续独立人工决定。",
        "多人共享待审队列，一轮仅一次有效审核决定；公示开启、正式提交和奖项替代共用ClassYear并发保护。",
        "RecognitionTask是recognition_runs与ai_analyses的聚合投影，不是新增表；OCR绑定确切页面，AI基线由修订引用。",
        "申请大类属于Application；ReviewDecision的revisionId必须等于round.revisionId。StateEvent的actorType和替代两端revisionId为派生属性。",
        "AwardSupersession存替代前oldLockVersion；恢复以supersededEventId与当前lastEventId等因果一致性作守卫，不虚设替代后版本字段。"
      ],
      "nodes": [
        {
          "id": "Application",
          "name": "Application 稳定申请",
          "stereotype": "entity",
          "attributes": [
            "applicationId: UUID",
            "enrollmentId: UUID",
            "categoryId: UUID",
            "workingRevisionId: UUID?",
            "currentRoundId: UUID?",
            "lockVersion: Integer"
          ],
          "operations": [
            "createWorkingRevision()",
            "currentStatus(): RoundStatus"
          ]
        },
        {
          "id": "ApplicationRevision",
          "name": "ApplicationRevision 内容修订",
          "stereotype": "entity",
          "attributes": [
            "revisionId / revisionNo",
            "applicationId / aiAnalysisId",
            "title: String",
            "requestedScore / studentModifiedScore",
            "activityId / competitionProjectId",
            "contentFrozenAt: DateTime?"
          ],
          "operations": [
            "freezeForSubmission()",
            "isEditable(): Boolean"
          ]
        },
        {
          "id": "SubmissionRound",
          "name": "SubmissionRound 提审轮次",
          "stereotype": "entity",
          "attributes": [
            "roundId / roundNo",
            "applicationId / revisionId: UUID",
            "state: RoundState",
            "eligibilityVersionId: UUID?",
            "isCurrentCandidate: Boolean",
            "lockVersion / lastEventId"
          ],
          "operations": [
            "transition(expectedVersion, event)",
            "isPending(): Boolean"
          ]
        },
        {
          "id": "ApplicationAttachment",
          "name": "ApplicationAttachment 修订附件",
          "stereotype": "entity",
          "attributes": [
            "attachmentId: UUID",
            "revisionId: UUID",
            "fileId: UUID",
            "displayOrder: Integer"
          ],
          "operations": [
            "sourceFile(): FileAsset"
          ]
        },
        {
          "id": "FileAsset",
          "name": "FileAsset 原始证明",
          "stereotype": "entity",
          "attributes": [
            "fileId: UUID",
            "ownerUserId: UUID",
            "mimeType / pageCount",
            "contentHash: String",
            "privateStorageRef: String",
            "uploadedAt: DateTime"
          ],
          "operations": [
            "page(pageNumber)"
          ]
        },
        {
          "id": "EvidenceCrop",
          "name": "EvidenceCrop 关键信息截图",
          "stereotype": "entity",
          "attributes": [
            "cropId / revisionId: UUID",
            "pageId: UUID",
            "evidenceType / source",
            "polygon: PagePolygon",
            "privateAssetRef / sourceHash",
            "publicAssetRef / publicAssetStatus"
          ],
          "operations": [
            "replaceRegion(region)",
            "publicView(): RedactedCrop"
          ]
        },
        {
          "id": "RecognitionTask",
          "name": "RecognitionTask 识别任务投影",
          "stereotype": "value object",
          "attributes": [
            "sourceKind: OCR_RUN|AI_ANALYSIS",
            "sourceId: UUID",
            "inputFingerprint: String",
            "status: RecognitionStatus",
            "/relatedRevisionIds: UUID[]",
            "resultRef / errorCode"
          ],
          "operations": [
            "isReusable(): Boolean",
            "requiresManualCompletion(): Boolean"
          ]
        },
        {
          "id": "ReviewDecision",
          "name": "ReviewDecision 人工审核",
          "stereotype": "entity",
          "attributes": [
            "decisionId: UUID",
            "roundId / revisionId: UUID",
            "actorId / roleAssignmentId",
            "stage: PEER|COUNSELOR",
            "action / rejectionReason",
            "comment / actorNameSnapshot"
          ],
          "operations": [
            "isRejection(): Boolean"
          ]
        },
        {
          "id": "StateEvent",
          "name": "StateEvent 状态历史",
          "stereotype": "entity",
          "attributes": [
            "eventId / applicationId: UUID",
            "roundId?: UUID / revisionId: UUID",
            "eventType: ApplicationEventType",
            "actorId?: UUID; /actorType",
            "fromState / toState",
            "operationId / occurredAt"
          ],
          "operations": [
            "isSystemTransition(): Boolean"
          ]
        },
        {
          "id": "AwardSupersession",
          "name": "AwardSupersession 奖项替代",
          "stereotype": "entity",
          "attributes": [
            "supersessionId: UUID",
            "newRoundId / oldRoundId",
            "/newRevisionId / oldRevisionId",
            "oldState / oldLockVersion",
            "supersededEventId / restoredEventId",
            "status: SupersessionStatus"
          ],
          "operations": [
            "applyImmediately()",
            "restoreIfStillApplicable()"
          ]
        },
        {
          "id": "ClassYear",
          "name": "ClassYear 班级学年",
          "stereotype": "entity",
          "attributes": [
            "classYearId: UUID",
            "classId: UUID",
            "academicYearId: UUID",
            "scoreRuleVersionId: UUID",
            "lockVersion: Integer",
            "/publicityState: from ClassPublicity"
          ],
          "operations": [
            "isPublic(): Boolean"
          ]
        },
        {
          "id": "ApplicationWorkflowService",
          "name": "ApplicationWorkflowService 申报审核",
          "stereotype": "service",
          "attributes": [
            "authorization: AuthorizationService",
            "roundRepository: RoundRepository",
            "supersessionPolicy: AwardPolicy",
            "classYearGuard: ConcurrencyGuard"
          ],
          "operations": [
            "submitAndFreeze(application)",
            "decideOrWithdraw(round)"
          ]
        }
      ],
      "edges": [
        {
          "from": "Application",
          "to": "ApplicationRevision",
          "type": "composition",
          "fromMultiplicity": "1",
          "toMultiplicity": "1..*",
          "label": "工作稿与冻结历史修订"
        },
        {
