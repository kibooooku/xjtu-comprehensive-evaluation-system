          "type": "composition",
          "fromMultiplicity": "1",
          "toMultiplicity": "0..*",
          "label": "完整业务历史"
        },
        {
          "from": "User",
          "to": "ReviewDecision",
          "type": "association",
          "fromMultiplicity": "1",
          "toMultiplicity": "0..*",
          "label": "经办人与角色快照"
        },
        {
          "from": "WorkflowService",
          "to": "Application",
          "type": "dependency",
          "fromMultiplicity": "",
          "toMultiplicity": "",
          "label": "版本校验与直接提交"
        },
        {
          "from": "WorkflowService",
          "to": "SubmissionRound",
          "type": "dependency",
          "fromMultiplicity": "",
          "toMultiplicity": "",
          "label": "状态推进 / 通过锁定"
        },
        {
          "from": "WorkflowService",
          "to": "ActivityEligibilityService",
          "type": "dependency",
          "fromMultiplicity": "",
          "toMultiplicity": "",
          "label": "仅三类需要资格"
        }
