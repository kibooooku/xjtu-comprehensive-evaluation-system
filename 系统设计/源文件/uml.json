          "type": "association",
          "fromMultiplicity": "1",
          "toMultiplicity": "0..*",
          "label": "绑定确切内容版本"
        },
        {
          "from": "SubmissionRound",
          "to": "ReviewDecision",
          "type": "composition",
          "fromMultiplicity": "1",
          "toMultiplicity": "0..*",
          "label": "学生初审 / 辅导员审查"
        },
        {
