{
  "diagrams": [
    {
      "id": "01-rbac-organization",
      "name": "RBAC与班级组织领域类图",
      "type": "class",
      "notes": [
        "User的基础身份互斥；班长、审查员是可叠加的RoleAssignment，不采用学生子类继承表达。",
        "权限判定=角色操作授权∩该条授权的数据范围∩强制业务策略；只在完整授权之间求并集。",
        "班长和审查员授权绑定classId；辅导员范围来自CounselorClassAssignment，学生本人及本班范围来自Enrollment。",
        "每班一名现任班长、至少两名不同的学生审查员；管理员不读取证明、不参与业务审核。",
        "Enrollment记录学生所选学年的班级归属；ClassYear同时作为公示和正式提交的并发边界。",
        "ClassYear./publicityState是读模型派生属性；唯一持久化当前公示状态在ClassPublicity.isOpen。",
        "RolePermission.dataScope为资源操作最大范围OWN/CLASS/LED_CLASSES/CLASS_PUBLIC/SYSTEM_METADATA；与Role.scopeKind和RoleAssignment实际范围相交后，再执行对象强制策略。"
      ],
      "nodes": [
        {
          "id": "User",
          "name": "User 用户",
          "stereotype": "entity",
          "attributes": [
            "userId: UUID",
            "username: String",
            "passwordHash: String",
            "baseIdentity: IdentityKind",
            "status: AccountStatus"
          ],
          "operations": [
            "isStudent(): Boolean"
          ]
        },
        {
          "id": "StudentProfile",
          "name": "StudentProfile 学生档案",
          "stereotype": "entity",
          "attributes": [
            "studentId: UUID",
            "userId: UUID",
            "studentNumber: String",
            "/displayName: from User",
            "profileStatus: ProfileStatus",
            "admissionYear: Integer?"
          ],
          "operations": [
            "maskedStudentNo(): String"
          ]
        },
        {
          "id": "TeachingClass",
          "name": "TeachingClass 教学班",
          "stereotype": "entity",
          "attributes": [
            "classId: UUID",
            "classCode: String",
            "className: String",
            "status: ClassStatus"
          ],
          "operations": [
            "activeReviewerCount(): Integer"
          ]
        },
        {
          "id": "AcademicYear",
          "name": "AcademicYear 学年",
          "stereotype": "entity",
          "attributes": [
            "academicYearId: UUID",
            "yearLabel: String",
            "displayOrder: Integer",
            "enabled: Boolean"
          ],
          "operations": [
            "availableForSelection(): Boolean"
          ]
        },
        {
          "id": "ClassYear",
          "name": "ClassYear 班级学年",
          "stereotype": "entity",
          "attributes": [
            "classYearId: UUID",
            "classId: UUID",
            "academicYearId: UUID",
            "scoreRuleVersionId: UUID",
            "lockVersion: Integer",
            "/publicityState: from ClassPublicity"
          ],
          "operations": [
            "isPublic(): Boolean"
          ]
        },
        {
          "id": "Enrollment",
          "name": "Enrollment 学年班级归属",
          "stereotype": "entity",
          "attributes": [
            "enrollmentId: UUID",
            "studentId: UUID",
            "classYearId: UUID",
            "status: EnrollmentStatus",
            "recordedAt / endedAt: DateTime?"
          ],
          "operations": [
            "belongsTo(classYear): Boolean"
          ]
        },
        {
          "id": "Role",
          "name": "Role 角色",
          "stereotype": "entity",
          "attributes": [
            "roleId: UUID",
            "roleCode: RoleCode",
            "roleName: String",
            "allowedIdentity: IdentityKind",
            "scopeKind: GLOBAL|CLASS",
            "isSystem: Boolean"
          ],
          "operations": [
            "accepts(user): Boolean"
          ]
        },
        {
          "id": "Permission",
          "name": "Permission 资源操作",
          "stereotype": "entity",
          "attributes": [
            "permissionId: UUID",
            "resourceCode: String",
            "actionCode: String",
            "description: String"
          ],
          "operations": [
            "matches(resource, action): Boolean"
          ]
        },
        {
          "id": "RolePermission",
          "name": "RolePermission 权限矩阵项",
          "stereotype": "entity",
          "attributes": [
            "rolePermissionId: UUID",
            "roleId / permissionId: UUID",
            "dataScope: PermissionScope",
            "isAllowed: Boolean",
            "changedBy / changedAt",
            "note: String?"
          ],
          "operations": [
            "permits(action): Boolean"
          ]
        },
        {
          "id": "RoleAssignment",
          "name": "RoleAssignment 角色赋予",
          "stereotype": "entity",
          "attributes": [
            "assignmentId: UUID",
            "userId / roleId: UUID",
            "classId: UUID?",
            "validFrom / validTo: DateTime?",
            "grantedBy: UUID",
            "revokedAt: DateTime?"
          ],
          "operations": [
            "isActive(now): Boolean"
          ]
        },
        {
          "id": "CounselorClassAssignment",
          "name": "CounselorClassAssignment 带班关系",
          "stereotype": "entity",
          "attributes": [
            "assignmentId: UUID",
            "counselorUserId: UUID",
            "classId: UUID",
            "validFrom / validTo: DateTime?",
            "assignedBy: UUID"
          ],
          "operations": [
            "isActive(now): Boolean"
          ]
        },
        {
          "id": "AuthorizationService",
          "name": "AuthorizationService 授权服务",
          "stereotype": "service",
          "attributes": [
            "roleRepository: RoleRepository",
            "scopeResolver: ScopeResolver",
            "mandatoryPolicy: BusinessPolicy",
            "auditSink: AuditSink"
          ],
          "operations": [
            "authorize(subject, action, object)",
            "resolveVisibleScope(subject, action)"
          ]
        }
      ],
      "edges": [
        {
          "from": "User",
          "to": "StudentProfile",
          "type": "composition",
          "fromMultiplicity": "1",
          "toMultiplicity": "0..1",
          "label": "基础身份为学生时具有档案"
        },
        {
          "from": "User",
          "to": "RoleAssignment",
          "type": "association",
          "fromMultiplicity": "1",
          "toMultiplicity": "1..*",
          "label": "拥有生效或历史角色"
        },
        {
          "from": "Role",
          "to": "RoleAssignment",
          "type": "association",
          "fromMultiplicity": "1",
          "toMultiplicity": "0..*",
          "label": "被赋予"
        },
        {
          "from": "Role",
          "to": "RolePermission",
          "type": "composition",
          "fromMultiplicity": "1",
          "toMultiplicity": "0..*",
          "label": "配置权限矩阵"
        },
        {
          "from": "Permission",
          "to": "RolePermission",
          "type": "association",
          "fromMultiplicity": "1",
          "toMultiplicity": "0..*",
          "label": "被角色授权"
        },
        {
          "from": "TeachingClass",
          "to": "RoleAssignment",
          "type": "association",
          "fromMultiplicity": "0..1",
          "toMultiplicity": "0..*",
          "label": "班长／审查员作用域"
        },
        {
          "from": "User",
          "to": "CounselorClassAssignment",
          "type": "association",
          "fromMultiplicity": "1",
          "toMultiplicity": "0..*",
          "label": "基础身份须为辅导员"
        },
        {
          "from": "TeachingClass",
          "to": "CounselorClassAssignment",
          "type": "association",
          "fromMultiplicity": "1",
          "toMultiplicity": "0..*",
          "label": "现任与历史带班关系"
        },
        {
          "from": "TeachingClass",
          "to": "ClassYear",
          "type": "composition",
          "fromMultiplicity": "1",
          "toMultiplicity": "0..*",
          "label": "各学年组织边界"
        },
        {
          "from": "AcademicYear",
          "to": "ClassYear",
          "type": "association",
          "fromMultiplicity": "1",
          "toMultiplicity": "0..*",
          "label": "属于学年"
        },
        {
          "from": "StudentProfile",
          "to": "Enrollment",
          "type": "association",
          "fromMultiplicity": "1",
          "toMultiplicity": "0..*",
          "label": "按所选学年归属"
        },
        {
          "from": "ClassYear",
          "to": "Enrollment",
          "type": "composition",
          "fromMultiplicity": "1",
          "toMultiplicity": "0..*",
          "label": "学生名册"
        },
        {
          "from": "AuthorizationService",
          "to": "RoleAssignment",
          "type": "dependency",
          "fromMultiplicity": "",
          "toMultiplicity": "",
          "label": "解析角色与班级范围"
        },
        {
          "from": "AuthorizationService",
          "to": "RolePermission",
          "type": "dependency",
          "fromMultiplicity": "",
          "toMultiplicity": "",
          "label": "校验资源×操作"
        },
        {
          "from": "AuthorizationService",
          "to": "Enrollment",
          "type": "dependency",
          "fromMultiplicity": "",
          "toMultiplicity": "",
          "label": "本人／本班范围"
        },
        {
          "from": "AuthorizationService",
          "to": "CounselorClassAssignment",
          "type": "dependency",
          "fromMultiplicity": "",
          "toMultiplicity": "",
          "label": "所带班级范围"
        }
      ]
