          "type": "association",
          "fromMultiplicity": "0..*",
          "toMultiplicity": "1",
          "label": "经确切FilePage及渲染版本"
        },
        {
          "from": "ApplicationRevision",
          "to": "RecognitionTask",
          "type": "association",
          "fromMultiplicity": "0..*",
          "toMultiplicity": "0..*",
          "label": "经附件页及AI建议基线关联"
        },
        {
          "from": "SubmissionRound",
          "to": "ReviewDecision",
          "type": "composition",
          "fromMultiplicity": "1",
          "toMultiplicity": "0..*",
          "label": "各阶段人工决定"
        },
        {
          "from": "SubmissionRound",
          "to": "StateEvent",
          "type": "association",
          "fromMultiplicity": "0..1",
