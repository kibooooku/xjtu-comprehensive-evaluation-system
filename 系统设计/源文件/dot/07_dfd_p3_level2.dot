digraph Design {
graph [rankdir=TB, bgcolor="white", pad="0.40", nodesep="0.55", ranksep="1.1", splines=polyline, overlap=false, forcelabels=true, outputorder=edgesfirst, fontname="Microsoft YaHei", fontsize=22];
node [fontname="Microsoft YaHei", fontsize=12, color="#38536b", penwidth=1.15];
edge [fontname="Microsoft YaHei", fontsize=10, color="#6e8599", fontcolor="#38536b", arrowsize=0.65, penwidth=1.0, labeldistance=1.8];
"E1" [shape=box, style="filled", fillcolor="#eaf1f8", width=2.2, margin="0.16,0.14", label="E1\n学生用户"];
"P4" [shape=box, style="filled", fillcolor="#eaf1f8", width=2.2, margin="0.16,0.14", label="P4\nP4 审核处理\n父图相邻进程"];
"P3.1" [shape=box, style="rounded,filled", fillcolor="#e4f3ec", color="#286b54", width=2.4, margin="0.18,0.16", label="P3.1\n核验正式提交\n与撤回资料"];
"P3.2" [shape=box, style="rounded,filled", fillcolor="#e4f3ec", color="#286b54", width=2.4, margin="0.18,0.16", label="P3.2\n识别同项目\n与奖项优先级"];
"P3.3" [shape=box, style="rounded,filled", fillcolor="#e4f3ec", color="#286b54", width=2.4, margin="0.18,0.16", label="P3.3\n记录正式申报\n与旧轮次替代"];
"P3.4" [shape=box, style="rounded,filled", fillcolor="#e4f3ec", color="#286b54", width=2.4, margin="0.18,0.16", label="P3.4\n记录撤回或\n接收驳回事实"];
"P3.5" [shape=box, style="rounded,filled", fillcolor="#e4f3ec", color="#286b54", width=2.4, margin="0.18,0.16", label="P3.5\n恢复替代所影响\n的旧提交轮次"];
"D1" [shape=plain, margin=0, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#8b754b"><TR><TD BORDER="1" SIDES="LRTB" BGCOLOR="#fff3d8">D1</TD><TD WIDTH="180" BORDER="1" SIDES="TB" BGCOLOR="#fff3d8">账号、角色与组织权限</TD></TR></TABLE>>];
"D2" [shape=plain, margin=0, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#8b754b"><TR><TD BORDER="1" SIDES="LRTB" BGCOLOR="#fff3d8">D2</TD><TD WIDTH="180" BORDER="1" SIDES="TB" BGCOLOR="#fff3d8">学年与评分标准</TD></TR></TABLE>>];
"D3" [shape=plain, margin=0, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#8b754b"><TR><TD BORDER="1" SIDES="LRTB" BGCOLOR="#fff3d8">D3</TD><TD WIDTH="180" BORDER="1" SIDES="TB" BGCOLOR="#fff3d8">申请、版本与提交轮次</TD></TR></TABLE>>];
"D4" [shape=plain, margin=0, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#8b754b"><TR><TD BORDER="1" SIDES="LRTB" BGCOLOR="#fff3d8">D4</TD><TD WIDTH="180" BORDER="1" SIDES="TB" BGCOLOR="#fff3d8">原文件与关键证据</TD></TR></TABLE>>];
"D5" [shape=plain, margin=0, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#8b754b"><TR><TD BORDER="1" SIDES="LRTB" BGCOLOR="#fff3d8">D5</TD><TD WIDTH="180" BORDER="1" SIDES="TB" BGCOLOR="#fff3d8">活动规范与资格认定</TD></TR></TABLE>>];
"D6" [shape=plain, margin=0, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#8b754b"><TR><TD BORDER="1" SIDES="LRTB" BGCOLOR="#fff3d8">D6</TD><TD WIDTH="180" BORDER="1" SIDES="TB" BGCOLOR="#fff3d8">审核与奖项替代履历</TD></TR></TABLE>>];
"D7" [shape=plain, margin=0, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#8b754b"><TR><TD BORDER="1" SIDES="LRTB" BGCOLOR="#fff3d8">D7</TD><TD WIDTH="180" BORDER="1" SIDES="TB" BGCOLOR="#fff3d8">班级学年公示设置</TD></TR></TABLE>>];
