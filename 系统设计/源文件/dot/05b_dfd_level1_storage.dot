digraph Design {
graph [rankdir=TB, bgcolor="white", pad="0.40", nodesep="0.55", ranksep="1.1", splines=polyline, overlap=false, forcelabels=true, outputorder=edgesfirst, fontname="Microsoft YaHei", fontsize=22];
node [fontname="Microsoft YaHei", fontsize=12, color="#38536b", penwidth=1.15];
edge [fontname="Microsoft YaHei", fontsize=10, color="#6e8599", fontcolor="#38536b", arrowsize=0.65, penwidth=1.0, labeldistance=1.8];
"P1" [shape=box, style="rounded,filled", fillcolor="#e4f3ec", color="#286b54", width=2.4, margin="0.18,0.16", label="P1\n身份组织与权限管理"];
"P2" [shape=box, style="rounded,filled", fillcolor="#e4f3ec", color="#286b54", width=2.4, margin="0.18,0.16", label="P2\n形成申请草稿与证据"];
"P3" [shape=box, style="rounded,filled", fillcolor="#e4f3ec", color="#286b54", width=2.4, margin="0.18,0.16", label="P3\n受理正式申报\n与奖项替代恢复"];
"P4" [shape=box, style="rounded,filled", fillcolor="#e4f3ec", color="#286b54", width=2.4, margin="0.18,0.16", label="P4\n办理学生与辅导员审核"];
"P5" [shape=box, style="rounded,filled", fillcolor="#e4f3ec", color="#286b54", width=2.4, margin="0.18,0.16", label="P5\n维护活动资格"];
"P6" [shape=box, style="rounded,filled", fillcolor="#e4f3ec", color="#286b54", width=2.4, margin="0.18,0.16", label="P6\n查询申请证据\n并计算成绩"];
"P7" [shape=box, style="rounded,filled", fillcolor="#e4f3ec", color="#286b54", width=2.4, margin="0.18,0.16", label="P7\n办理公示与Excel导出"];
"D1" [shape=plain, margin=0, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#8b754b"><TR><TD BORDER="1" SIDES="LRTB" BGCOLOR="#fff3d8">D1</TD><TD WIDTH="180" BORDER="1" SIDES="TB" BGCOLOR="#fff3d8">账号、角色与组织权限</TD></TR></TABLE>>];
"D2" [shape=plain, margin=0, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#8b754b"><TR><TD BORDER="1" SIDES="LRTB" BGCOLOR="#fff3d8">D2</TD><TD WIDTH="180" BORDER="1" SIDES="TB" BGCOLOR="#fff3d8">学年与评分标准</TD></TR></TABLE>>];
