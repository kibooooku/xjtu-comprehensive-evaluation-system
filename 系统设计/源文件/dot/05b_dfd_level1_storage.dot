"D5" [shape=plain, margin=0, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#8b754b"><TR><TD BORDER="1" SIDES="LRTB" BGCOLOR="#fff3d8">D5</TD><TD WIDTH="180" BORDER="1" SIDES="TB" BGCOLOR="#fff3d8">活动规范与资格认定</TD></TR></TABLE>>];
