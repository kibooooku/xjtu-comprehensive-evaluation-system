digraph Design {
graph [rankdir=TB, bgcolor="white", pad="0.40", nodesep="0.55", ranksep="1.1", splines=polyline, overlap=false, forcelabels=true, outputorder=edgesfirst, fontname="Microsoft YaHei", fontsize=22];
node [fontname="Microsoft YaHei", fontsize=12, color="#38536b", penwidth=1.15];
edge [fontname="Microsoft YaHei", fontsize=10, color="#6e8599", fontcolor="#38536b", arrowsize=0.65, penwidth=1.0, labeldistance=1.8];
"E1" [shape=box, style="filled", fillcolor="#eaf1f8", width=2.2, margin="0.16,0.14", label="E1\n学生用户\n含班长／审查员职责"];
"E2" [shape=box, style="filled", fillcolor="#eaf1f8", width=2.2, margin="0.16,0.14", label="E2\n辅导员"];
"E3" [shape=box, style="filled", fillcolor="#eaf1f8", width=2.2, margin="0.16,0.14", label="E3\n系统管理员"];
"E4" [shape=box, style="filled", fillcolor="#eaf1f8", width=2.2, margin="0.16,0.14", label="E4\n腾讯云 OCR\n高精度文字＋印章"];
"E5" [shape=box, style="filled", fillcolor="#eaf1f8", width=2.2, margin="0.16,0.14", label="E5\nDeepSeek"];
"P0" [shape=box, style="rounded,filled", fillcolor="#e4f3ec", color="#286b54", width=2.4, margin="0.18,0.16", label="P0\n德育分统计系统"];
"E1" -> "P0" [id="e0", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2" BGCOLOR="white"><TR><TD WIDTH="150"><FONT POINT-SIZE="10">C-F01</FONT></TD></TR><TR><TD WIDTH="150"><FONT POINT-SIZE="10">学生申报、确认与审查资料</FONT></TD></TR></TABLE>>, tooltip="登录与班级查询资料；申请原件、字段与截图修订；提交／撤回及项目关联确认；[审查员]意见；[班长]任免及导出资料；申请／成绩／公示查询条件", color="#326a80", fontcolor="#294f64"];
"P0" -> "E1" [id="e1", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2" BGCOLOR="white"><TR><TD WIDTH="150"><FONT POINT-SIZE="10">C-F02</FONT></TD></TR><TR><TD WIDTH="150"><FONT POINT-SIZE="10">建议、审核回执及公示成绩</FONT></TD></TR></TABLE>>, tooltip="身份与脱敏班级信息；AI建议及人工补填提示；申请回执与审核结果；授权申请／原件／成绩；脱敏公示；[班长]任免结果及Excel", color="#326a80", fontcolor="#294f64",constraint=false];
"E2" -> "P0" [id="e2", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2" BGCOLOR="white"><TR><TD WIDTH="150"><FONT POINT-SIZE="10">C-F03</FONT></TD></TR><TR><TD WIDTH="150"><FONT POINT-SIZE="10">审核、资格、公示与导出资</FONT></TD></TR><TR><TD WIDTH="150"><FONT POINT-SIZE="10">料</FONT></TD></TR></TABLE>>, tooltip="登录与班级查询资料；申请／成绩查询条件；审核及活动资格认定资料；活动维护资料；公示设置与导出条件", color="#326a80", fontcolor="#294f64"];
"P0" -> "E2" [id="e3", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2" BGCOLOR="white"><TR><TD WIDTH="150"><FONT POINT-SIZE="10">C-F04</FONT></TD></TR><TR><TD WIDTH="150"><FONT POINT-SIZE="10">待审材料、办理结果及报表</FONT></TD></TR></TABLE>>, tooltip="身份与所带班级；审核材料／原件／成绩；审核与活动维护结果；受影响历史申请；公示办理结果及Excel", color="#326a80", fontcolor="#294f64",constraint=false];
"E3" -> "P0" [id="e4", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2" BGCOLOR="white"><TR><TD WIDTH="150"><FONT POINT-SIZE="10">C-F05</FONT></TD></TR><TR><TD WIDTH="150"><FONT POINT-SIZE="10">账号、组织与权限配置</FONT></TD></TR></TABLE>>, tooltip="登录资料；账号、组织关系与权限维护资料", color="#326a80", fontcolor="#294f64"];
"P0" -> "E3" [id="e5", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2" BGCOLOR="white"><TR><TD WIDTH="150"><FONT POINT-SIZE="10">C-F06</FONT></TD></TR><TR><TD WIDTH="150"><FONT POINT-SIZE="10">身份与配置处理结果</FONT></TD></TR></TABLE>>, tooltip="身份结果；账号、组织关系与权限办理结果", color="#326a80", fontcolor="#294f64",constraint=false];
"P0" -> "E4" [id="e6", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2" BGCOLOR="white"><TR><TD WIDTH="150"><FONT POINT-SIZE="10">C-F07</FONT></TD></TR><TR><TD WIDTH="150"><FONT POINT-SIZE="10">待识别材料及接口类型</FONT></TD></TR></TABLE>>, tooltip="待识别文件页；文字／印章识别类型", color="#326a80", fontcolor="#294f64",constraint=false];
"E4" -> "P0" [id="e7", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2" BGCOLOR="white"><TR><TD WIDTH="150"><FONT POINT-SIZE="10">C-F08</FONT></TD></TR><TR><TD WIDTH="150"><FONT POINT-SIZE="10">文字、印章及位置结果</FONT></TD></TR></TABLE>>, tooltip="文字、置信度及位置；印章内容及位置；失败／额度耗尽结果", color="#326a80", fontcolor="#294f64"];
"P0" -> "E5" [id="e8", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2" BGCOLOR="white"><TR><TD WIDTH="150"><FONT POINT-SIZE="10">C-F09</FONT></TD></TR><TR><TD WIDTH="150"><FONT POINT-SIZE="10">识别文本、规则与活动候选</FONT></TD></TR></TABLE>>, tooltip="识别文本、学生所选大类、适用评分标准、规范活动候选", color="#326a80", fontcolor="#294f64",constraint=false];
"E5" -> "P0" [id="e9", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2" BGCOLOR="white"><TR><TD WIDTH="150"><FONT POINT-SIZE="10">C-F10</FONT></TD></TR><TR><TD WIDTH="150"><FONT POINT-SIZE="10">条目、分值及匹配建议</FONT></TD></TR></TABLE>>, tooltip="条目细项、建议分值、活动匹配建议；失败结果", color="#326a80", fontcolor="#294f64"];
