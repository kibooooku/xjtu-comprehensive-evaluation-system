digraph Design {
graph [rankdir=LR, bgcolor="white", pad="0.40", nodesep="0.55", ranksep="1.1", splines=polyline, overlap=false, forcelabels=true, outputorder=edgesfirst, fontname="Microsoft YaHei", fontsize=22];
node [fontname="Microsoft YaHei", fontsize=12, color="#38536b", penwidth=1.15];
edge [fontname="Microsoft YaHei", fontsize=10, color="#6e8599", fontcolor="#38536b", arrowsize=0.65, penwidth=1.0, labeldistance=1.8];
"class_years" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#7c8994"><TR><TD WIDTH="250" BGCOLOR="#7c8994"><FONT COLOR="white" POINT-SIZE="13"><B>class_years</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">班级学年（引用）</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR></TABLE>>];
"activities" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#6f4c91"><TR><TD WIDTH="385" BGCOLOR="#6f4c91"><FONT COLOR="white" POINT-SIZE="13"><B>activities</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">规范活动</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 canonical_name : VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 normalized_name : VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 organizer : VARCHAR(255) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 description : TEXT ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 status : ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> maintained_by : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 created_at : TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 updated_at : TIMESTAMP</FONT></TD></TR></TABLE>>];
"activity_aliases" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#6f4c91"><TR><TD WIDTH="385" BGCOLOR="#6f4c91"><FONT COLOR="white" POINT-SIZE="13"><B>activity_aliases</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">活动别名</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> activity_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 alias : VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 normalized_alias : VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> created_by : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 created_at : TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 status : ENUM</FONT></TD></TR></TABLE>>];
"activity_eligibility_versions" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#6f4c91"><TR><TD WIDTH="385" BGCOLOR="#6f4c91"><FONT COLOR="white" POINT-SIZE="13"><B>activity_eligibility_versions</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">活动资格认定版本</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> activity_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> category_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 scope_key : VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 edition_key : VARCHAR(100) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 track_key : VARCHAR(100) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 group_key : VARCHAR(100) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> academic_year_id : UUID ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 version_no : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 decision : ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 effective_at : TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> decided_by : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> source_review_decision_id : UUID ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 reason : TEXT ?</FONT></TD></TR></TABLE>>];
"competition_projects" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#6f4c91"><TR><TD WIDTH="385" BGCOLOR="#6f4c91"><FONT COLOR="white" POINT-SIZE="13"><B>competition_projects</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">竞赛项目身份</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> activity_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 edition_key : VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 track_key : VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 group_key : VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 work_key : VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 identity_fingerprint : CHAR(64) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 status : ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> confirmed_by : UUID ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 confirmed_at : TIMESTAMP ?</FONT></TD></TR></TABLE>>];
"score_categories" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#6f4c91"><TR><TD WIDTH="385" BGCOLOR="#6f4c91"><FONT COLOR="white" POINT-SIZE="13"><B>score_categories</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">七类评分目录</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 code : VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 name : VARCHAR(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 default_cap : DECIMAL(6,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 aggregation_kind : ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 requires_eligibility_review : BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 sort_order : INTEGER</FONT></TD></TR></TABLE>>];
"score_rule_versions" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#6f4c91"><TR><TD WIDTH="385" BGCOLOR="#6f4c91"><FONT COLOR="white" POINT-SIZE="13"><B>score_rule_versions</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">评分规则版本</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 version_label : VARCHAR(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 baseline_score : DECIMAL(6,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 rounding_mode : ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 source_document : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 rules_json : JSON</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 published_at : TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> published_by : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 status : ENUM</FONT></TD></TR></TABLE>>];
"class_publicity" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#93602b"><TR><TD WIDTH="385" BGCOLOR="#93602b"><FONT COLOR="white" POINT-SIZE="13"><B>class_publicity</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">班级学年公示开关</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> class_year_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 is_open : BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 lock_version : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> opened_by : UUID ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 opened_at : TIMESTAMP ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> closed_by : UUID ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 closed_at : TIMESTAMP ?</FONT></TD></TR></TABLE>>];
"publicity_events" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#93602b"><TR><TD WIDTH="385" BGCOLOR="#93602b"><FONT COLOR="white" POINT-SIZE="13"><B>publicity_events</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">公示操作历史</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> publicity_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 event_no : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 action : ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> actor_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 pending_count_checked : INTEGER ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 occurred_at : TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 note : TEXT ?</FONT></TD></TR></TABLE>>];
"activities" -> "activity_aliases" [id="e0", dir=both, arrowtail=teetee, arrowhead=crowodot, label="activity_id", color="#6f4c91"];
"activities" -> "activity_eligibility_versions" [id="e1", dir=both, arrowtail=teetee, arrowhead=crowodot, label="activity_id", color="#6f4c91"];
"activities" -> "competition_projects" [id="e2", dir=both, arrowtail=teetee, arrowhead=crowodot, label="activity_id", color="#6f4c91"];
"class_years" -> "class_publicity" [id="e3", dir=both, arrowtail=teetee, arrowhead=teetee, label="class_year_id", color="#93602b"];
"class_publicity" -> "publicity_events" [id="e4", dir=both, arrowtail=teetee, arrowhead=crowodot, label="publicity_id", color="#93602b"];
}