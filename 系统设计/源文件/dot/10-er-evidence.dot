digraph Design {
graph [rankdir=LR, bgcolor="white", pad="0.40", nodesep="0.55", ranksep="1.1", splines=polyline, overlap=false, forcelabels=true, outputorder=edgesfirst, fontname="Microsoft YaHei", fontsize=22];
node [fontname="Microsoft YaHei", fontsize=12, color="#38536b", penwidth=1.15];
edge [fontname="Microsoft YaHei", fontsize=10, color="#6e8599", fontcolor="#38536b", arrowsize=0.65, penwidth=1.0, labeldistance=1.8];
"users" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#7c8994"><TR><TD WIDTH="250" BGCOLOR="#7c8994"><FONT COLOR="white" POINT-SIZE="13"><B>users</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">用户（引用）</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR></TABLE>>];
"file_objects" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#237260"><TR><TD WIDTH="385" BGCOLOR="#237260"><FONT COLOR="white" POINT-SIZE="13"><B>file_objects</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">原始证明文件</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> uploaded_by : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 original_name : VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 mime_type : VARCHAR(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 byte_size : BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 sha256 : CHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 storage_uri : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 created_at : TIMESTAMP</FONT></TD></TR></TABLE>>];
"file_pages" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#237260"><TR><TD WIDTH="385" BGCOLOR="#237260"><FONT COLOR="white" POINT-SIZE="13"><B>file_pages</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">文件页面</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> file_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 page_index : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 render_version : VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 width_px : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 height_px : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 rotation_degrees : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 image_uri : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 render_sha256 : CHAR(64)</FONT></TD></TR></TABLE>>];
"recognition_runs" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#237260"><TR><TD WIDTH="385" BGCOLOR="#237260"><FONT COLOR="white" POINT-SIZE="13"><B>recognition_runs</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">OCR识别运行</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> page_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 provider : VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 api_name : VARCHAR(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 parameters_hash : CHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 status : ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 provider_request_id : VARCHAR(100) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 result_json : JSON ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 started_at : TIMESTAMP ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 finished_at : TIMESTAMP ?</FONT></TD></TR></TABLE>>];
"recognition_regions" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#237260"><TR><TD WIDTH="385" BGCOLOR="#237260"><FONT COLOR="white" POINT-SIZE="13"><B>recognition_regions</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">识别文字及印章区域</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> run_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 region_no : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 kind : ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 text : TEXT ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 confidence : DECIMAL(6,4) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 polygon_json : JSON</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 extra_json : JSON ?</FONT></TD></TR></TABLE>>];
"ai_analyses" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#237260"><TR><TD WIDTH="385" BGCOLOR="#237260"><FONT COLOR="white" POINT-SIZE="13"><B>ai_analyses</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">AI建议记录</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> application_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> input_revision_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 input_fingerprint : CHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> score_rule_version_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 model_name : VARCHAR(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 prompt_version : VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 status : ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 suggested_title : VARCHAR(255) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 suggested_score : DECIMAL(6,2) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> suggested_activity_id : UUID ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 result_json : JSON ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 created_at : TIMESTAMP</FONT></TD></TR></TABLE>>];
"analysis_inputs" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#237260"><TR><TD WIDTH="385" BGCOLOR="#237260"><FONT COLOR="white" POINT-SIZE="13"><B>analysis_inputs</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">AI识别输入关系</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> analysis_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> file_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> page_id : UUID ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> recognition_run_id : UUID ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 input_kind : ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 input_hash : CHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 sort_order : INTEGER</FONT></TD></TR></TABLE>>];
"applications" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#7c8994"><TR><TD WIDTH="250" BGCOLOR="#7c8994"><FONT COLOR="white" POINT-SIZE="13"><B>applications</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">申请聚合根（引用）</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR></TABLE>>];
"application_revisions" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#7c8994"><TR><TD WIDTH="250" BGCOLOR="#7c8994"><FONT COLOR="white" POINT-SIZE="13"><B>application_revisions</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">申请内容版本（引用）</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR></TABLE>>];
"revision_files" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#237260"><TR><TD WIDTH="385" BGCOLOR="#237260"><FONT COLOR="white" POINT-SIZE="13"><B>revision_files</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">版本附件关系</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> revision_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> file_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 sort_order : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 purpose : VARCHAR(80) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> added_by : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 added_at : TIMESTAMP</FONT></TD></TR></TABLE>>];
"evidence_crops" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#237260"><TR><TD WIDTH="385" BGCOLOR="#237260"><FONT COLOR="white" POINT-SIZE="13"><B>evidence_crops</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">关键证据与公示脱敏版</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> revision_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> page_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 evidence_type : ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 source : ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> recognition_region_id : UUID ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 polygon_json : JSON</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 private_asset_uri : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 source_hash : CHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 redaction_version : VARCHAR(40) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 masks_json : JSON ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 public_asset_uri : TEXT ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 public_asset_status : ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 sort_order : INTEGER</FONT></TD></TR></TABLE>>];
"users" -> "file_objects" [id="e0", dir=both, arrowtail=teetee, arrowhead=crowodot, label="uploaded_by", color="#237260"];
"file_objects" -> "file_pages" [id="e1", dir=both, arrowtail=teetee, arrowhead=crowodot, label="file_id", color="#237260"];
