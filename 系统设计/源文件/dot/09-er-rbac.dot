digraph Design {
graph [rankdir=LR, bgcolor="white", pad="0.40", nodesep="0.55", ranksep="1.1", splines=polyline, overlap=false, forcelabels=true, outputorder=edgesfirst, fontname="Microsoft YaHei", fontsize=22];
node [fontname="Microsoft YaHei", fontsize=12, color="#38536b", penwidth=1.15];
edge [fontname="Microsoft YaHei", fontsize=10, color="#6e8599", fontcolor="#38536b", arrowsize=0.65, penwidth=1.0, labeldistance=1.8];
"users" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#2b5d8b"><TR><TD WIDTH="385" BGCOLOR="#2b5d8b"><FONT COLOR="white" POINT-SIZE="13"><B>users</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">用户</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 username : VARCHAR(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 password_hash : VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 display_name : VARCHAR(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 base_identity : ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 status : ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 created_at : TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 last_login_at : TIMESTAMP ?</FONT></TD></TR></TABLE>>];
"student_profiles" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#2b5d8b"><TR><TD WIDTH="385" BGCOLOR="#2b5d8b"><FONT COLOR="white" POINT-SIZE="13"><B>student_profiles</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">学生档案</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> user_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 student_number : VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 admission_year : SMALLINT ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 profile_status : ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 created_at : TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 updated_at : TIMESTAMP</FONT></TD></TR></TABLE>>];
"classes" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#2b5d8b"><TR><TD WIDTH="385" BGCOLOR="#2b5d8b"><FONT COLOR="white" POINT-SIZE="13"><B>classes</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">班级</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 code : VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 name : VARCHAR(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 program_name : VARCHAR(80) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 cohort_year : SMALLINT ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 status : ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 created_at : TIMESTAMP</FONT></TD></TR></TABLE>>];
"academic_years" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#2b5d8b"><TR><TD WIDTH="385" BGCOLOR="#2b5d8b"><FONT COLOR="white" POINT-SIZE="13"><B>academic_years</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">学年</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 code : VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 name : VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 sort_order : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 is_selectable : BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 reference_start : DATE ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 reference_end : DATE ?</FONT></TD></TR></TABLE>>];
"class_years" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#2b5d8b"><TR><TD WIDTH="385" BGCOLOR="#2b5d8b"><FONT COLOR="white" POINT-SIZE="13"><B>class_years</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">班级学年</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> class_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> academic_year_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> score_rule_version_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 lock_version : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 created_at : TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 updated_at : TIMESTAMP</FONT></TD></TR></TABLE>>];
"enrollments" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#2b5d8b"><TR><TD WIDTH="385" BGCOLOR="#2b5d8b"><FONT COLOR="white" POINT-SIZE="13"><B>enrollments</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">学生班级学年归属</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> student_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> class_year_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 status : ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 recorded_at : TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 ended_at : TIMESTAMP ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> managed_by : UUID</FONT></TD></TR></TABLE>>];
"roles" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#2b5d8b"><TR><TD WIDTH="385" BGCOLOR="#2b5d8b"><FONT COLOR="white" POINT-SIZE="13"><B>roles</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">角色</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 code : VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 name : VARCHAR(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 allowed_identity : ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 scope_kind : ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 is_system : BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 description : TEXT</FONT></TD></TR></TABLE>>];
"permissions" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#2b5d8b"><TR><TD WIDTH="385" BGCOLOR="#2b5d8b"><FONT COLOR="white" POINT-SIZE="13"><B>permissions</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">权限项</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 code : VARCHAR(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 name : VARCHAR(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 module : VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 action : VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 boundary_note : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 is_system : BOOLEAN</FONT></TD></TR></TABLE>>];
"role_permissions" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#2b5d8b"><TR><TD WIDTH="385" BGCOLOR="#2b5d8b"><FONT COLOR="white" POINT-SIZE="13"><B>role_permissions</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">角色权限矩阵</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> role_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> permission_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 data_scope : ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 is_allowed : BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> changed_by : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 changed_at : TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 note : TEXT ?</FONT></TD></TR></TABLE>>];
"role_assignments" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#2b5d8b"><TR><TD WIDTH="385" BGCOLOR="#2b5d8b"><FONT COLOR="white" POINT-SIZE="13"><B>role_assignments</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">用户角色授权</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> user_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> role_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> class_id : UUID ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> granted_by : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 valid_from : TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 valid_to : TIMESTAMP ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 status : ENUM</FONT></TD></TR></TABLE>>];
