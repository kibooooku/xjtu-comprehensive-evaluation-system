digraph CurrentDesign {
graph [rankdir=TB,bgcolor="white",pad="0.36",nodesep="0.55",ranksep="1.18",splines=polyline,overlap=false,outputorder=edgesfirst,fontname="Arial",fontsize=12];
node [shape=plain,fontname="Arial",fontsize=12,margin=0];
edge [fontname="Arial",fontsize=10,color="#7b8e9f",fontcolor="#334c62",arrowsize=0.7,penwidth=1.1,labeldistance=2.0];
"User" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#697d8e"><TR><TD WIDTH="400" BGCOLOR="#697d8e"><FONT COLOR="white" POINT-SIZE="11">«reference»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>User</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">任务所有人</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− id: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: users</FONT></TD></TR></TABLE>>];
"ApplicationRevision" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#697d8e"><TR><TD WIDTH="400" BGCOLOR="#697d8e"><FONT COLOR="white" POINT-SIZE="11">«reference»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>ApplicationRevision</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">输入版本</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− id: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− /contentFingerprint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− /filesFingerprint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: application_revisions</FONT></TD></TR></TABLE>>];
"RevisionFile" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#285c84"><TR><TD WIDTH="400" BGCOLOR="#285c84"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>RevisionFile</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">版本附件</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− revisionId / fileId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− sortOrder / addedBy</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: revision_files</FONT></TD></TR></TABLE>>];
"FileObject" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#285c84"><TR><TD WIDTH="400" BGCOLOR="#285c84"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>FileObject</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">原始材料</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− id / uploadedBy: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− originalName / mimeType</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− byteSize / sha256 / storageUri</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: file_objects</FONT></TD></TR></TABLE>>];
"FilePage" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#285c84"><TR><TD WIDTH="400" BGCOLOR="#285c84"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>FilePage</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">原件页</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− fileId / pageIndex</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− renderVersion / renderSha256</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− widthPx / heightPx / imageUri</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: file_pages</FONT></TD></TR></TABLE>>];
"RecognitionRun" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#285c84"><TR><TD WIDTH="400" BGCOLOR="#285c84"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>RecognitionRun</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">文字或印章识别</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− pageId / provider / apiName</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− parametersHash / status</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− resultJson / startedAt / finishedAt</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: recognition_runs</FONT></TD></TR></TABLE>>];
"RecognitionRegion" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#285c84"><TR><TD WIDTH="400" BGCOLOR="#285c84"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>RecognitionRegion</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">文字与位置</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− runId / regionNo</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− kind / text / confidence</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− polygonJson / extraJson</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: recognition_regions</FONT></TD></TR></TABLE>>];
"EvidenceCrop" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#285c84"><TR><TD WIDTH="400" BGCOLOR="#285c84"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>EvidenceCrop</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">证据截图</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− revisionId / pageId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− evidenceType / source</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− polygonJson / masksJson</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− privateAsset / publicAssetStatus</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: evidence_crops</FONT></TD></TR></TABLE>>];
"AIAnalysis" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#285c84"><TR><TD WIDTH="400" BGCOLOR="#285c84"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>AIAnalysis</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">活动与政策建议</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− applicationId / inputRevisionId</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− inputFingerprint / status</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− suggestedTitle / suggestedScore</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− suggestedActivityId / resultJson</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: ai_analyses</FONT></TD></TR></TABLE>>];
"AnalysisInput" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#285c84"><TR><TD WIDTH="400" BGCOLOR="#285c84"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>AnalysisInput</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">分析来源</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− analysisId / fileId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− pageId / recognitionRunId: UUID?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− inputKind / inputHash / sortOrder</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: analysis_inputs</FONT></TD></TR></TABLE>>];
"BackgroundJob" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#285c84"><TR><TD WIDTH="400" BGCOLOR="#285c84"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>BackgroundJob</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">持久后台任务</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− ownerId / applicationId / kind</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− inputRevisionId / inputFingerprint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− state / stage / progress / total</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− workerToken / heartbeatAt / resultJson</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− state: QUEUED | RUNNING | PAUSED | terminal</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: background_jobs</FONT></TD></TR></TABLE>>];
"JobWorker" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#725096"><TR><TD WIDTH="400" BGCOLOR="#725096"><FONT COLOR="white" POINT-SIZE="11">«service»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>JobWorker</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">独立队列调度</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− ownerConcurrency: OCR=3 / AI=3</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− globalPools: OCR=12 / AI=12</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− workerToken / stopEvent</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f1edf7"><FONT POINT-SIZE="12">+ start() / run() / stop()</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f1edf7"><FONT POINT-SIZE="12">+ _claim_next(kind)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f1edf7"><FONT POINT-SIZE="12">+ process_job(job, worker_token)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f1edf7"><FONT POINT-SIZE="12">+ pause_owner() / resume_owner()</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f1edf7"><FONT POINT-SIZE="12">+ presence() / leave()</FONT></TD></TR></TABLE>>];
"MaterialService" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#725096"><TR><TD WIDTH="400" BGCOLOR="#725096"><FONT COLOR="white" POINT-SIZE="11">«service»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>MaterialService</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">识别与应用</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− PDF文字层 / 腾讯云OCR</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− sealPages: 首页与末页</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− fileLeaseLimitPerOwner: 3</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f1edf7"><FONT POINT-SIZE="12">+ run_ocr() / run_ai(ocr_result)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f1edf7"><FONT POINT-SIZE="12">+ apply_ocr_evidence()</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f1edf7"><FONT POINT-SIZE="12">+ apply_analysis()</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f1edf7"><FONT POINT-SIZE="12">+ prepare_ocr_image()</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f1edf7"><FONT POINT-SIZE="12">+ tencent_ocr() / _original_ocr_coordinates()</FONT></TD></TR></TABLE>>];
"SystemSetting" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#697d8e"><TR><TD WIDTH="400" BGCOLOR="#697d8e"><FONT COLOR="white" POINT-SIZE="11">«reference»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>SystemSetting</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">设置与用量归档</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− id: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− valueJson: JSON</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− changedBy / updatedAt</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− task_control: owner pause + live tabs JSON</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: system_settings</FONT></TD></TR></TABLE>>];
"ApplicationRevision" -> "RevisionFile" [id="e0",label="版本的附件集合",dir=both,arrowhead=none,arrowtail=diamond,taillabel="1",headlabel="0..*"];
"FileObject" -> "RevisionFile" [id="e1",label="原件关联",dir=both,arrowhead=none,arrowtail=none,taillabel="1",headlabel="0..*"];
"FileObject" -> "FilePage" [id="e2",label="逐页渲染",dir=both,arrowhead=none,arrowtail=diamond,taillabel="1",headlabel="0..*"];
"FilePage" -> "RecognitionRun" [id="e3",label="本地文字层 / 云文字 / 印章",dir=both,arrowhead=none,arrowtail=none,taillabel="1",headlabel="0..*"];
"RecognitionRun" -> "RecognitionRegion" [id="e4",label="原页文字位置",dir=both,arrowhead=none,arrowtail=diamond,taillabel="1",headlabel="0..*"];
"ApplicationRevision" -> "EvidenceCrop" [id="e5",label="参与及有效性证据",dir=both,arrowhead=none,arrowtail=diamond,taillabel="1",headlabel="0..*"];
"FilePage" -> "EvidenceCrop" [id="e6",label="原页、坐标与页码",dir=both,arrowhead=none,arrowtail=none,taillabel="1",headlabel="0..*"];
"RecognitionRegion" -> "EvidenceCrop" [id="e7",label="自动证据来源，手工可空",dir=both,arrowhead=none,arrowtail=none,taillabel="0..1",headlabel="0..*"];
"ApplicationRevision" -> "AIAnalysis" [id="e8",label="分析输入快照",dir=both,arrowhead=none,arrowtail=none,taillabel="1",headlabel="0..*"];
"AIAnalysis" -> "AnalysisInput" [id="e9",label="可追溯输入",dir=both,arrowhead=none,arrowtail=diamond,taillabel="1",headlabel="0..*"];
"FileObject" -> "AnalysisInput" [id="e10",label="证明材料来源",dir=both,arrowhead=none,arrowtail=none,taillabel="1",headlabel="0..*"];
"RecognitionRun" -> "AnalysisInput" [id="e11",label="识别结果来源，可空",dir=both,arrowhead=none,arrowtail=none,taillabel="0..1",headlabel="0..*"];
"User" -> "BackgroundJob" [id="e12",label="仅所有人可查询",dir=both,arrowhead=none,arrowtail=none,taillabel="1",headlabel="0..*"];
"ApplicationRevision" -> "BackgroundJob" [id="e13",label="精确输入版本",dir=both,arrowhead=none,arrowtail=none,taillabel="1",headlabel="0..*"];
"JobWorker" -> "BackgroundJob" [id="e14",label="原子领取及所有权校验",style=dashed,arrowhead=vee,color="#927ba8"];
"JobWorker" -> "MaterialService" [id="e15",label="分别调度OCR与AI",style=dashed,arrowhead=vee,color="#927ba8"];
"MaterialService" -> "RecognitionRun" [id="e16",label="内容缓存与用量预留",style=dashed,arrowhead=vee,color="#927ba8"];
"MaterialService" -> "SystemSetting" [id="e17",label="按月接口计数 + 归档",style=dashed,arrowhead=vee,color="#927ba8"];
"BackgroundJob" -> "BackgroundJob" [id="e18",label="AI依赖OCR完成（JSON逻辑引\n用）",style=dashed,arrowhead=vee,color="#927ba8"];
