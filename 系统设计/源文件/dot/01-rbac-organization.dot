digraph Design {
graph [rankdir=TB, bgcolor="white", pad="0.40", nodesep="0.55", ranksep="1.1", splines=polyline, overlap=false, forcelabels=true, outputorder=edgesfirst, fontname="Microsoft YaHei", fontsize=22];
node [fontname="Microsoft YaHei", fontsize=12, color="#38536b", penwidth=1.15];
edge [fontname="Microsoft YaHei", fontsize=10, color="#6e8599", fontcolor="#38536b", arrowsize=0.65, penwidth=1.0, labeldistance=1.8];
"User" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#285d87"><TR><TD WIDTH="340" BGCOLOR="#285d87" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>User</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">用户</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− userId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− username: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− passwordHash: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− baseIdentity: IdentityKind</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− status: AccountStatus</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ isStudent(): Boolean</FONT></TD></TR></TABLE>>];
"StudentProfile" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#285d87"><TR><TD WIDTH="340" BGCOLOR="#285d87" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>StudentProfile</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">学生档案</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− studentId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− userId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− studentNumber: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− /displayName: from User</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− profileStatus: ProfileStatus</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− admissionYear: Integer?</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ maskedStudentNo(): String</FONT></TD></TR></TABLE>>];
"TeachingClass" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#285d87"><TR><TD WIDTH="340" BGCOLOR="#285d87" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>TeachingClass</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">教学班</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− classId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− classCode: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− className: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− status: ClassStatus</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ activeReviewerCount(): Integer</FONT></TD></TR></TABLE>>];
"AcademicYear" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#285d87"><TR><TD WIDTH="340" BGCOLOR="#285d87" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>AcademicYear</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">学年</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− academicYearId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− yearLabel: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− displayOrder: Integer</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− enabled: Boolean</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ availableForSelection(): Boolean</FONT></TD></TR></TABLE>>];
"ClassYear" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#285d87"><TR><TD WIDTH="340" BGCOLOR="#285d87" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>ClassYear</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">班级学年</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− classYearId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− classId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− academicYearId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− scoreRuleVersionId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− lockVersion: Integer</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− /publicityState: from ClassPublicity</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ isPublic(): Boolean</FONT></TD></TR></TABLE>>];
"Enrollment" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#285d87"><TR><TD WIDTH="340" BGCOLOR="#285d87" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>Enrollment</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">学年班级归属</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− enrollmentId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− studentId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− classYearId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− status: EnrollmentStatus</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− recordedAt: DateTime?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− endedAt: DateTime?</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ belongsTo(classYear): Boolean</FONT></TD></TR></TABLE>>];
"Role" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#285d87"><TR><TD WIDTH="340" BGCOLOR="#285d87" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>Role</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">角色</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− roleId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− roleCode: RoleCode</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− roleName: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− allowedIdentity: IdentityKind</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− scopeKind: GLOBAL|CLASS</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− isSystem: Boolean</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ accepts(user): Boolean</FONT></TD></TR></TABLE>>];
"Permission" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#285d87"><TR><TD WIDTH="340" BGCOLOR="#285d87" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>Permission</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">资源操作</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− permissionId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− resourceCode: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− actionCode: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− description: String</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ matches(resource, action): Boolean</FONT></TD></TR></TABLE>>];
"RolePermission" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#285d87"><TR><TD WIDTH="340" BGCOLOR="#285d87" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>RolePermission</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">权限矩阵项</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− rolePermissionId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− roleId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− permissionId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− dataScope: PermissionScope</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− isAllowed: Boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− changedBy / changedAt</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− note: String?</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ permits(action): Boolean</FONT></TD></TR></TABLE>>];
"RoleAssignment" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#285d87"><TR><TD WIDTH="340" BGCOLOR="#285d87" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>RoleAssignment</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">角色赋予</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− assignmentId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− userId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− roleId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− classId: UUID?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− validFrom: DateTime?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− validTo: DateTime?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− grantedBy: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− revokedAt: DateTime?</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ isActive(now): Boolean</FONT></TD></TR></TABLE>>];
"CounselorClassAssignment" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#285d87"><TR><TD WIDTH="340" BGCOLOR="#285d87" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>CounselorClassAssignment</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">带班关系</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− assignmentId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− counselorUserId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− classId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− validFrom: DateTime?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− validTo: DateTime?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− assignedBy: UUID</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ isActive(now): Boolean</FONT></TD></TR></TABLE>>];
"AuthorizationService" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#69508d"><TR><TD WIDTH="340" BGCOLOR="#69508d" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11">«service»</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>AuthorizationService</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">授权服务</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− roleRepository: RoleRepository</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− scopeResolver: ScopeResolver</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− mandatoryPolicy: BusinessPolicy</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− auditSink: AuditSink</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ authorize(subject, action, object)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ resolveVisibleScope(subject, action)</FONT></TD></TR></TABLE>>];
