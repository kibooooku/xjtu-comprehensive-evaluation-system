digraph Design {
graph [rankdir=LR, bgcolor="white", pad="0.40", nodesep="0.55", ranksep="1.1", splines=polyline, overlap=false, forcelabels=true, outputorder=edgesfirst, fontname="Microsoft YaHei", fontsize=22];
node [fontname="Microsoft YaHei", fontsize=12, color="#38536b", penwidth=1.15];
edge [fontname="Microsoft YaHei", fontsize=10, color="#6e8599", fontcolor="#38536b", arrowsize=0.65, penwidth=1.0, labeldistance=1.8];
"users" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#7c8994"><TR><TD WIDTH="250" BGCOLOR="#7c8994"><FONT COLOR="white" POINT-SIZE="13"><B>users</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">用户（引用）</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR></TABLE>>];
"enrollments" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#7c8994"><TR><TD WIDTH="250" BGCOLOR="#7c8994"><FONT COLOR="white" POINT-SIZE="13"><B>enrollments</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">学生班级学年归属（引用）</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR></TABLE>>];
"ai_analyses" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#7c8994"><TR><TD WIDTH="250" BGCOLOR="#7c8994"><FONT COLOR="white" POINT-SIZE="13"><B>ai_analyses</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">AI建议记录（引用）</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR></TABLE>>];
"activities" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#7c8994"><TR><TD WIDTH="250" BGCOLOR="#7c8994"><FONT COLOR="white" POINT-SIZE="13"><B>activities</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">规范活动（引用）</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR></TABLE>>];
"competition_projects" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#7c8994"><TR><TD WIDTH="250" BGCOLOR="#7c8994"><FONT COLOR="white" POINT-SIZE="13"><B>competition_projects</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">竞赛项目身份（引用）</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR></TABLE>>];
"applications" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#93602b"><TR><TD WIDTH="385" BGCOLOR="#93602b"><FONT COLOR="white" POINT-SIZE="13"><B>applications</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">申请聚合根</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> enrollment_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> category_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> working_revision_id : UUID ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> current_round_id : UUID ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 lock_version : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 created_at : TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 archived_at : TIMESTAMP ?</FONT></TD></TR></TABLE>>];
"application_revisions" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#93602b"><TR><TD WIDTH="385" BGCOLOR="#93602b"><FONT COLOR="white" POINT-SIZE="13"><B>application_revisions</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">申请内容版本</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> application_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 revision_no : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 title : VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 requested_score : DECIMAL(6,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 student_modified_score : BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> activity_id : UUID ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> competition_project_id : UUID ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> ai_analysis_id : UUID ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 payload_json : JSON</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 content_frozen_at : TIMESTAMP ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> created_by : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 created_at : TIMESTAMP</FONT></TD></TR></TABLE>>];
"submission_rounds" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#93602b"><TR><TD WIDTH="385" BGCOLOR="#93602b"><FONT COLOR="white" POINT-SIZE="13"><B>submission_rounds</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">申请提审轮次</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> application_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> revision_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 round_no : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 state : ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> eligibility_version_id : UUID ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 competition_group_key : CHAR(64) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 is_current_candidate : BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 lock_version : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 submitted_at : TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> last_event_id : UUID ?</FONT></TD></TR></TABLE>>];
"review_decisions" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#93602b"><TR><TD WIDTH="385" BGCOLOR="#93602b"><FONT COLOR="white" POINT-SIZE="13"><B>review_decisions</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">审核决定</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> round_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> revision_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> actor_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> role_assignment_id : UUID ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 stage : ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 action : ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 rejection_reason : ENUM ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 comment : TEXT ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 actor_name_snapshot : VARCHAR(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 decided_at : TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 idempotency_key : VARCHAR(100)</FONT></TD></TR></TABLE>>];
"application_events" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#93602b"><TR><TD WIDTH="385" BGCOLOR="#93602b"><FONT COLOR="white" POINT-SIZE="13"><B>application_events</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">申请状态与操作事件</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> application_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> round_id : UUID ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> revision_id : UUID ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 event_no : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 event_type : ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 actor_type : ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> actor_id : UUID ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 from_state : VARCHAR(40) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 to_state : VARCHAR(40) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 detail_json : JSON</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 occurred_at : TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 operation_id : VARCHAR(100)</FONT></TD></TR></TABLE>>];
"award_supersessions" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#93602b"><TR><TD WIDTH="385" BGCOLOR="#93602b"><FONT COLOR="white" POINT-SIZE="13"><B>award_supersessions</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">奖项替代与恢复关联</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> new_round_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> old_round_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 competition_group_key : CHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 old_state : ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 old_lock_version : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> superseded_event_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11"><B>FK</B> restored_event_id : UUID ?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 status : ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 comparison_snapshot_json : JSON</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 created_at : TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="11">　 resolved_at : TIMESTAMP ?</FONT></TD></TR></TABLE>>];
"score_categories" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#7c8994"><TR><TD WIDTH="250" BGCOLOR="#7c8994"><FONT COLOR="white" POINT-SIZE="13"><B>score_categories</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="12">七类评分目录（引用）</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf0f5"><FONT POINT-SIZE="11"><B>PK</B> id : UUID</FONT></TD></TR></TABLE>>];
"enrollments" -> "applications" [id="e0", dir=both, arrowtail=teetee, arrowhead=crowodot, label="enrollment_id", color="#93602b"];
"score_categories" -> "applications" [id="e1", dir=both, arrowtail=teetee, arrowhead=crowodot, label="category_id", color="#93602b"];
"applications" -> "application_revisions" [id="e2", dir=both, arrowtail=teetee, arrowhead=crowodot, label="application_id", color="#93602b"];
"ai_analyses" -> "application_revisions" [id="e3", dir=both, arrowtail=teeodot, arrowhead=crowodot, label="ai_analysis_id", color="#93602b"];
"activities" -> "application_revisions" [id="e4", dir=both, arrowtail=teeodot, arrowhead=crowodot, label="activity_id", color="#93602b"];
"competition_projects" -> "application_revisions" [id="e5", dir=both, arrowtail=teeodot, arrowhead=crowodot, label="competition_project_id", color="#93602b"];
"applications" -> "submission_rounds" [id="e6", dir=both, arrowtail=teetee, arrowhead=crowodot, label="application_id", color="#93602b"];
"application_revisions" -> "submission_rounds" [id="e7", dir=both, arrowtail=teetee, arrowhead=crowodot, label="revision_id", color="#93602b"];
"submission_rounds" -> "review_decisions" [id="e8", dir=both, arrowtail=teetee, arrowhead=crowodot, label="round_id", color="#93602b"];
"users" -> "review_decisions" [id="e9", dir=both, arrowtail=teetee, arrowhead=crowodot, label="actor_id", color="#93602b"];
"applications" -> "application_events" [id="e10", dir=both, arrowtail=teetee, arrowhead=crowodot, label="application_id", color="#93602b"];
"submission_rounds" -> "award_supersessions" [id="e11", dir=both, arrowtail=teetee, arrowhead=crowodot, label="new_round_id", color="#93602b"];
"submission_rounds" -> "award_supersessions" [id="e12", dir=both, arrowtail=teetee, arrowhead=crowodot, label="old_round_id", color="#93602b"];
}