"E5" [shape=box, style="filled", fillcolor="#eaf1f8", width=2.2, margin="0.16,0.14", label="E5\nDeepSeek"];
"P1" [shape=box, style="rounded,filled", fillcolor="#e4f3ec", color="#286b54", width=2.4, margin="0.18,0.16", label="P1\n身份组织与权限管理"];
"P2" [shape=box, style="rounded,filled", fillcolor="#e4f3ec", color="#286b54", width=2.4, margin="0.18,0.16", label="P2\n形成申请草稿与证据"];
"P3" [shape=box, style="rounded,filled", fillcolor="#e4f3ec", color="#286b54", width=2.4, margin="0.18,0.16", label="P3\n受理正式申报\n与奖项替代恢复"];
"P4" [shape=box, style="rounded,filled", fillcolor="#e4f3ec", color="#286b54", width=2.4, margin="0.18,0.16", label="P4\n办理学生与辅导员审核"];
"P5" [shape=box, style="rounded,filled", fillcolor="#e4f3ec", color="#286b54", width=2.4, margin="0.18,0.16", label="P5\n维护活动资格"];
"P6" [shape=box, style="rounded,filled", fillcolor="#e4f3ec", color="#286b54", width=2.4, margin="0.18,0.16", label="P6\n查询申请证据\n并计算成绩"];
"P7" [shape=box, style="rounded,filled", fillcolor="#e4f3ec", color="#286b54", width=2.4, margin="0.18,0.16", label="P7\n办理公示与Excel导出"];
