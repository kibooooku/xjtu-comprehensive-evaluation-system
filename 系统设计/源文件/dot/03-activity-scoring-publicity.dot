digraph Design {
graph [rankdir=TB, bgcolor="white", pad="0.40", nodesep="0.55", ranksep="1.1", splines=polyline, overlap=false, forcelabels=true, outputorder=edgesfirst, fontname="Microsoft YaHei", fontsize=22];
node [fontname="Microsoft YaHei", fontsize=12, color="#38536b", penwidth=1.15];
edge [fontname="Microsoft YaHei", fontsize=10, color="#6e8599", fontcolor="#38536b", arrowsize=0.65, penwidth=1.0, labeldistance=1.8];
"ActivityCatalogEntry" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#285d87"><TR><TD WIDTH="340" BGCOLOR="#285d87" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>ActivityCatalogEntry</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">规范活动</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− activityId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− canonicalName: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− normalizedName: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− status: CatalogStatus</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− maintainedBy: UUID</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ canonicalLabel(): String</FONT></TD></TR></TABLE>>];
"ActivityAlias" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#285d87"><TR><TD WIDTH="340" BGCOLOR="#285d87" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>ActivityAlias</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">活动别名</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− aliasId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− activityId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− aliasText: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− normalizedAlias: String</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ matches(text): Boolean</FONT></TD></TR></TABLE>>];
"ActivityQualification" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#285d87"><TR><TD WIDTH="340" BGCOLOR="#285d87" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>ActivityQualification</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">资格认定</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− eligibilityVersionId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− activityId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− categoryId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− scopeKey / scopeDimensions</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− versionNo / effectiveAt</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− decision: EligibilityDecision</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− decidedBy / sourceReviewDecisionId</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ appliesTo(context): Boolean</FONT></TD></TR></TABLE>>];
"CompetitionProject" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#285d87"><TR><TD WIDTH="340" BGCOLOR="#285d87" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>CompetitionProject</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">具体参赛项目</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− projectId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− activityId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− editionKey: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− trackKey / groupKey</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− workKey: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− identityFingerprint / status</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ sameProject(other): Boolean</FONT></TD></TR></TABLE>>];
"ScoreCategory" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#285d87"><TR><TD WIDTH="340" BGCOLOR="#285d87" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>ScoreCategory</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">七类入口</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− categoryCode: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− categoryName: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− capScore: Decimal</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− counselorGateRequired: Boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− displayOrder: Integer</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ isCompetitionCategory(): Boolean</FONT></TD></TR></TABLE>>];
"ScoreRule" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#285d87"><TR><TD WIDTH="340" BGCOLOR="#285d87" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11">«policy»</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>ScoreRule</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">计分汇总规则</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− ruleId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− categoryCode: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− ruleCode / ruleVersion</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− aggregationMode: RuleMode</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− capScore: Decimal?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− sourceReference: String</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ aggregate(approvedRevisions)</FONT></TD></TR></TABLE>>];
"ApplicationRevision" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#285d87"><TR><TD WIDTH="340" BGCOLOR="#285d87" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>ApplicationRevision</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">内容修订</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− revisionId / revisionNo</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− applicationId / aiAnalysisId</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− title: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− requestedScore / studentModifiedScore</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− activityId / competitionProjectId</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− contentFrozenAt: DateTime?</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ freezeForSubmission()</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ isEditable(): Boolean</FONT></TD></TR></TABLE>>];
"ScoreSummary" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#285d87"><TR><TD WIDTH="340" BGCOLOR="#285d87" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11">«value object»</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>ScoreSummary</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">派生分数汇总</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− studentUserId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− classYearId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− baseScore: Decimal = 70</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− categoryTotals: CategoryScores</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− totalScore: Decimal</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− sourceVersion: String</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ calculateTotal(): Decimal</FONT></TD></TR></TABLE>>];
"ClassYear" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#285d87"><TR><TD WIDTH="340" BGCOLOR="#285d87" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>ClassYear</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">班级学年</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− classYearId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− classId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− academicYearId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− scoreRuleVersionId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− lockVersion: Integer</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− /publicityState: from ClassPublicity</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ isPublic(): Boolean</FONT></TD></TR></TABLE>>];
"ClassPublicity" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#285d87"><TR><TD WIDTH="340" BGCOLOR="#285d87" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>ClassPublicity</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">当前公示开关</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− publicityId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− classYearId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− isOpen: Boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− lockVersion: Integer</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− openedBy / openedAt</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− closedBy / closedAt</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ isOpen(): Boolean</FONT></TD></TR></TABLE>>];
"ScoringService" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#69508d"><TR><TD WIDTH="340" BGCOLOR="#69508d" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11">«service»</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>ScoringService</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">计分服务</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− baseline: Decimal = 70</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− roundingMode: HALF_UP</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− scoreScale: Integer = 2</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− approvedRoundQuery: Query</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ summarize(student, classYear)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ compareAwardPriority(a, b)</FONT></TD></TR></TABLE>>];
"PublicityService" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#69508d"><TR><TD WIDTH="340" BGCOLOR="#69508d" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11">«service»</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>PublicityService</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">公示服务</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− authorization: AuthorizationService</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− pendingRoundQuery: Query</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− classYearGuard: ConcurrencyGuard</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− redactionPolicy: RedactionPolicy</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ openIfNoPending(classYear)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ close(classYear)</FONT></TD></TR></TABLE>>];
"ActivityCatalogEntry" -> "ActivityAlias" [id="e0",label="统一名称与别名",taillabel="1",headlabel="0..*",dir=both,arrowhead=none,arrowtail=diamond];
"ActivityCatalogEntry" -> "ActivityQualification" [id="e1",label="适用范围及认定历史",taillabel="1",headlabel="0..*",dir=both,arrowhead=none,arrowtail=diamond];
"ActivityCatalogEntry" -> "CompetitionProject" [id="e2",label="规范赛事的具体项目",taillabel="1",headlabel="0..*",dir=both,arrowhead=none,arrowtail=none];
"CompetitionProject" -> "ApplicationRevision" [id="e3",label="同学生同项目比较",taillabel="0..1",headlabel="0..*",dir=both,arrowhead=none,arrowtail=none];
"ActivityCatalogEntry" -> "ApplicationRevision" [id="e4",label="规范名称匹配",taillabel="0..1",headlabel="0..*",dir=both,arrowhead=none,arrowtail=none];
"ScoreCategory" -> "ScoreRule" [id="e5",label="汇总策略及版本",taillabel="1",headlabel="1..*",dir=both,arrowhead=none,arrowtail=diamond];
"ScoreCategory" -> "ApplicationRevision" [id="e6",label="/由稳定Application派生类\n别",taillabel="1",headlabel="0..*",dir=both,arrowhead=none,arrowtail=none];
"ClassYear" -> "ClassPublicity" [id="e7",label="唯一当前开关；历史另存事\n件",taillabel="1",headlabel="1",dir=both,arrowhead=none,arrowtail=diamond];
"ScoringService" -> "ApplicationRevision" [id="e8",label="只取当前已通过轮次内容",style=dashed,arrowhead=vee,color="#8c79a2"];
"ScoringService" -> "ScoreRule" [id="e9",label="封顶／取最高／两位小数",style=dashed,arrowhead=vee,color="#8c79a2"];
"ScoringService" -> "ScoreSummary" [id="e10",label="生成派生汇总",style=dashed,arrowhead=vee,color="#8c79a2"];
"ScoringService" -> "CompetitionProject" [id="e11",label="高分优先，同分比较层级",style=dashed,arrowhead=vee,color="#8c79a2"];
"PublicityService" -> "ClassYear" [id="e12",label="串行检查待审与设置公示",style=dashed,arrowhead=vee,color="#8c79a2"];
"PublicityService" -> "ClassPublicity" [id="e13",label="修改唯一当前状态并追加开\n关事件",style=dashed,arrowhead=vee,color="#8c79a2"];
"PublicityService" -> "ScoreSummary" [id="e14",label="发布实时脱敏视图",style=dashed,arrowhead=vee,color="#8c79a2"];
}