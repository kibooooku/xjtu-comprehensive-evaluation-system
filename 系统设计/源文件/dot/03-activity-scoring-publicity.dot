digraph CurrentDesign {
graph [rankdir=TB,bgcolor="white",pad="0.36",nodesep="0.55",ranksep="1.18",splines=polyline,overlap=false,outputorder=edgesfirst,fontname="Arial",fontsize=12];
node [shape=plain,fontname="Arial",fontsize=12,margin=0];
edge [fontname="Arial",fontsize=10,color="#7b8e9f",fontcolor="#334c62",arrowsize=0.7,penwidth=1.1,labeldistance=2.0];
"Activity" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#285c84"><TR><TD WIDTH="400" BGCOLOR="#285c84"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>Activity</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">已认定活动</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− id: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− canonicalName / normalizedName</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− status / maintainedBy</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: activities</FONT></TD></TR></TABLE>>];
"ActivityAlias" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#285c84"><TR><TD WIDTH="400" BGCOLOR="#285c84"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>ActivityAlias</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">活动别名</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− activityId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− alias / normalizedAlias</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− status: AliasStatus</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: activity_aliases</FONT></TD></TR></TABLE>>];
"ActivityEligibilityVersion" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#285c84"><TR><TD WIDTH="400" BGCOLOR="#285c84"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>ActivityEligibilityVersion</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">资格版本</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− activityId / categoryId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− academicYearId: UUID?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− decision / versionNo</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− scopeKey / effectiveAt</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: activity_eligibility_versions</FONT></TD></TR></TABLE>>];
"ScoreCategory" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#285c84"><TR><TD WIDTH="400" BGCOLOR="#285c84"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>ScoreCategory</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">加分类别</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− id / code: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− defaultCap: Decimal(6,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− aggregationKind: SUM | MAX</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− requiresEligibilityReview: Boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: score_categories</FONT></TD></TR></TABLE>>];
"ScoreRuleVersion" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#285c84"><TR><TD WIDTH="400" BGCOLOR="#285c84"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>ScoreRuleVersion</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">评分规则</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− id / versionLabel</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− baselineScore: Decimal(6,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− roundingMode / rulesJson</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− sourceDocument / publishedAt</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: score_rule_versions</FONT></TD></TR></TABLE>>];
"ClassYear" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#697d8e"><TR><TD WIDTH="400" BGCOLOR="#697d8e"><FONT COLOR="white" POINT-SIZE="11">«reference»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>ClassYear</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">班级学年</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− id / scoreRuleVersionId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− lockVersion: Integer</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: class_years</FONT></TD></TR></TABLE>>];
"SubmissionRound" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#697d8e"><TR><TD WIDTH="400" BGCOLOR="#697d8e"><FONT COLOR="white" POINT-SIZE="11">«reference»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>SubmissionRound</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">当前审核轮次</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− revisionId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− state: APPROVED 或其它</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− eligibilityVersionId: UUID?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: submission_rounds</FONT></TD></TR></TABLE>>];
"ApplicationRevision" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#697d8e"><TR><TD WIDTH="400" BGCOLOR="#697d8e"><FONT COLOR="white" POINT-SIZE="11">«reference»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>ApplicationRevision</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">冻结内容</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− title / requestedScore</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− activityId: UUID?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− payloadJson / contentFrozenAt</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: application_revisions</FONT></TD></TR></TABLE>>];
"ClassPublicity" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#285c84"><TR><TD WIDTH="400" BGCOLOR="#285c84"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>ClassPublicity</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">公示当前状态</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− classYearId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− isOpen: Boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− lockVersion: Integer</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− openedAt / closedAt</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: class_publicity</FONT></TD></TR></TABLE>>];
"PublicityEvent" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#285c84"><TR><TD WIDTH="400" BGCOLOR="#285c84"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>PublicityEvent</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">公示历史</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− publicityId / eventNo</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− action / actorId</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− pendingCountChecked / occurredAt</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: publicity_events</FONT></TD></TR></TABLE>>];
"ActivityMatchService" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#725096"><TR><TD WIDTH="400" BGCOLOR="#725096"><FONT COLOR="white" POINT-SIZE="11">«service»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>ActivityMatchService</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">活动检索</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− fullCatalog / aliases</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− EXACT_NAME / EXACT_ALIAS / RELATED</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f1edf7"><FONT POINT-SIZE="12">+ search_activities(query, year, category)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f1edf7"><FONT POINT-SIZE="12">+ retrieve_activity_candidates(texts)</FONT></TD></TR></TABLE>>];
"ActivityEligibilityService" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#725096"><TR><TD WIDTH="400" BGCOLOR="#725096"><FONT COLOR="white" POINT-SIZE="11">«service»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>ActivityEligibilityService</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">资格判定</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− activity / category / year</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− decision: VALID | INVALID | UNKNOWN</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f1edf7"><FONT POINT-SIZE="12">+ simplified_eligibility(versions)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f1edf7"><FONT POINT-SIZE="12">+ activity_eligibility(...)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f1edf7"><FONT POINT-SIZE="12">+ _set_eligibility(...)</FONT></TD></TR></TABLE>>];
"ScoreService" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#725096"><TR><TD WIDTH="400" BGCOLOR="#725096"><FONT COLOR="white" POINT-SIZE="11">«service»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>ScoreService</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">计分与公示服务</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− derivedTotals / categoryCaps</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− baseline: 70</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f1edf7"><FONT POINT-SIZE="12">+ normalize_policy_suggestion(...)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f1edf7"><FONT POINT-SIZE="12">+ class_scores / build_scores</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f1edf7"><FONT POINT-SIZE="12">+ set_publicity(...)</FONT></TD></TR></TABLE>>];
"ExportService" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#725096"><TR><TD WIDTH="400" BGCOLOR="#725096"><FONT COLOR="white" POINT-SIZE="11">«service»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>ExportService</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">Excel与标准文件</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− schoolStandard: protected PDF</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− workbookColumns: 15</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f1edf7"><FONT POINT-SIZE="12">+ export_scores / export_workbook</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f1edf7"><FONT POINT-SIZE="12">+ scoring_standard()</FONT></TD></TR></TABLE>>];
"Activity" -> "ActivityAlias" [id="e0",label="名称别名",dir=both,arrowhead=none,arrowtail=diamond,taillabel="1",headlabel="0..*"];
