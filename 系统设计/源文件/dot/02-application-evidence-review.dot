digraph Design {
graph [rankdir=TB, bgcolor="white", pad="0.40", nodesep="0.55", ranksep="1.1", splines=polyline, overlap=false, forcelabels=true, outputorder=edgesfirst, fontname="Microsoft YaHei", fontsize=22];
node [fontname="Microsoft YaHei", fontsize=12, color="#38536b", penwidth=1.15];
edge [fontname="Microsoft YaHei", fontsize=10, color="#6e8599", fontcolor="#38536b", arrowsize=0.65, penwidth=1.0, labeldistance=1.8];
"Application" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#285d87"><TR><TD WIDTH="340" BGCOLOR="#285d87" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>Application</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">稳定申请</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− applicationId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− enrollmentId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− categoryId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− workingRevisionId: UUID?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− currentRoundId: UUID?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− lockVersion: Integer</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ createWorkingRevision()</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ currentStatus(): RoundStatus</FONT></TD></TR></TABLE>>];
"ApplicationRevision" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#285d87"><TR><TD WIDTH="340" BGCOLOR="#285d87" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>ApplicationRevision</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">内容修订</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− revisionId / revisionNo</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− applicationId / aiAnalysisId</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− title: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− requestedScore / studentModifiedScore</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− activityId / competitionProjectId</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− contentFrozenAt: DateTime?</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ freezeForSubmission()</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ isEditable(): Boolean</FONT></TD></TR></TABLE>>];
"SubmissionRound" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#285d87"><TR><TD WIDTH="340" BGCOLOR="#285d87" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>SubmissionRound</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">提审轮次</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− roundId / roundNo</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− applicationId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− revisionId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− state: RoundState</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− eligibilityVersionId: UUID?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− isCurrentCandidate: Boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− lockVersion / lastEventId</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ transition(expectedVersion, event)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ isPending(): Boolean</FONT></TD></TR></TABLE>>];
"ApplicationAttachment" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#285d87"><TR><TD WIDTH="340" BGCOLOR="#285d87" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>ApplicationAttachment</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">修订附件</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− attachmentId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− revisionId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− fileId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− displayOrder: Integer</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ sourceFile(): FileAsset</FONT></TD></TR></TABLE>>];
"FileAsset" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#285d87"><TR><TD WIDTH="340" BGCOLOR="#285d87" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>FileAsset</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">原始证明</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− fileId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− ownerUserId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− mimeType / pageCount</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− contentHash: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− privateStorageRef: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− uploadedAt: DateTime</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ page(pageNumber)</FONT></TD></TR></TABLE>>];
"EvidenceCrop" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#285d87"><TR><TD WIDTH="340" BGCOLOR="#285d87" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>EvidenceCrop</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">关键信息截图</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− cropId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− revisionId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− pageId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− evidenceType / source</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− polygon: PagePolygon</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− privateAssetRef / sourceHash</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− publicAssetRef / publicAssetStatus</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ replaceRegion(region)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ publicView(): RedactedCrop</FONT></TD></TR></TABLE>>];
"RecognitionTask" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#285d87"><TR><TD WIDTH="340" BGCOLOR="#285d87" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11">«value object»</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>RecognitionTask</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">识别任务投影</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− sourceKind: OCR_RUN|AI_ANALYSIS</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− sourceId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− inputFingerprint: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− status: RecognitionStatus</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− /relatedRevisionIds: UUID[]</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− resultRef / errorCode</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ isReusable(): Boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ requiresManualCompletion(): Boolean</FONT></TD></TR></TABLE>>];
"ReviewDecision" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#285d87"><TR><TD WIDTH="340" BGCOLOR="#285d87" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>ReviewDecision</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">人工审核</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− decisionId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− roundId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− revisionId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− actorId / roleAssignmentId</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− stage: PEER|COUNSELOR</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− action / rejectionReason</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− comment / actorNameSnapshot</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ isRejection(): Boolean</FONT></TD></TR></TABLE>>];
"StateEvent" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#285d87"><TR><TD WIDTH="340" BGCOLOR="#285d87" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>StateEvent</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">状态历史</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− eventId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− applicationId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− roundId?: UUID / revisionId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− eventType: ApplicationEventType</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− actorId?: UUID; /actorType</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− fromState / toState</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− operationId / occurredAt</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ isSystemTransition(): Boolean</FONT></TD></TR></TABLE>>];
"AwardSupersession" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#285d87"><TR><TD WIDTH="340" BGCOLOR="#285d87" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>AwardSupersession</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">奖项替代</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− supersessionId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− newRoundId / oldRoundId</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− /newRevisionId / oldRevisionId</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− oldState / oldLockVersion</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− supersededEventId / restoredEventId</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− status: SupersessionStatus</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ applyImmediately()</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ restoreIfStillApplicable()</FONT></TD></TR></TABLE>>];
"ClassYear" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#285d87"><TR><TD WIDTH="340" BGCOLOR="#285d87" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>ClassYear</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">班级学年</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− classYearId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− classId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− academicYearId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− scoreRuleVersionId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− lockVersion: Integer</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− /publicityState: from ClassPublicity</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ isPublic(): Boolean</FONT></TD></TR></TABLE>>];
"ApplicationWorkflowService" [shape=plain, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#69508d"><TR><TD WIDTH="340" BGCOLOR="#69508d" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11">«service»</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>ApplicationWorkflowService</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">申报审核</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− authorization: AuthorizationService</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− roundRepository: RoundRepository</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− supersessionPolicy: AwardPolicy</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fc"><FONT POINT-SIZE="12">− classYearGuard: ConcurrencyGuard</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ submitAndFreeze(application)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f0f8"><FONT POINT-SIZE="12">+ decideOrWithdraw(round)</FONT></TD></TR></TABLE>>];
"Application" -> "ApplicationRevision" [id="e0",label="工作稿与冻结历史修订",taillabel="1",headlabel="1..*",dir=both,arrowhead=none,arrowtail=diamond];
"Application" -> "SubmissionRound" [id="e1",label="历次提审；currentRound指\n针",taillabel="1",headlabel="0..*",dir=both,arrowhead=none,arrowtail=diamond];
"SubmissionRound" -> "ApplicationRevision" [id="e2",label="本轮审核的冻结内容",taillabel="0..*",headlabel="1",dir=both,arrowhead=none,arrowtail=none];
"ApplicationRevision" -> "ApplicationAttachment" [id="e3",label="正式提交时至少一个",taillabel="1",headlabel="0..*",dir=both,arrowhead=none,arrowtail=diamond];
"ApplicationAttachment" -> "FileAsset" [id="e4",label="原始文件",taillabel="0..*",headlabel="1",dir=both,arrowhead=none,arrowtail=none];
"ApplicationRevision" -> "EvidenceCrop" [id="e5",label="两类证据均可多图",taillabel="1",headlabel="0..*",dir=both,arrowhead=none,arrowtail=diamond];
"EvidenceCrop" -> "FileAsset" [id="e6",label="经确切FilePage及渲染版本",taillabel="0..*",headlabel="1",dir=both,arrowhead=none,arrowtail=none];
"ApplicationRevision" -> "RecognitionTask" [id="e7",label="经附件页及AI建议基线关联",taillabel="0..*",headlabel="0..*",dir=both,arrowhead=none,arrowtail=none];
"SubmissionRound" -> "ReviewDecision" [id="e8",label="各阶段人工决定",taillabel="1",headlabel="0..*",dir=both,arrowhead=none,arrowtail=diamond];
"SubmissionRound" -> "StateEvent" [id="e9",label="工作稿事件不绑定轮次",taillabel="0..1",headlabel="1..*",dir=both,arrowhead=none,arrowtail=none];
"AwardSupersession" -> "SubmissionRound" [id="e10",label="新申请轮次",taillabel="0..*",headlabel="1",dir=both,arrowhead=none,arrowtail=none];
"AwardSupersession" -> "SubmissionRound" [id="e11",label="被替代旧轮次",taillabel="0..*",headlabel="1",dir=both,arrowhead=none,arrowtail=none];
"ClassYear" -> "Application" [id="e12",label="经Enrollment确定归属",taillabel="1",headlabel="0..*",dir=both,arrowhead=none,arrowtail=none];
"ApplicationWorkflowService" -> "ClassYear" [id="e13",label="提交／公示并发边界",style=dashed,arrowhead=vee,color="#8c79a2"];
"ApplicationWorkflowService" -> "SubmissionRound" [id="e14",label="校验状态、非自审、推进轮\n次",style=dashed,arrowhead=vee,color="#8c79a2"];
"ApplicationWorkflowService" -> "AwardSupersession" [id="e15",label="正式提交替代；失败恢复",style=dashed,arrowhead=vee,color="#8c79a2"];
"Application" -> "StateEvent" [id="e16",label="包含工作稿及提审操作历史",taillabel="1",headlabel="0..*",dir=both,arrowhead=none,arrowtail=diamond];
}