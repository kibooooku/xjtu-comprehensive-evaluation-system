digraph Design {
graph [rankdir=TB, bgcolor="white", pad="0.40", nodesep="0.55", ranksep="1.1", splines=polyline, overlap=false, forcelabels=true, outputorder=edgesfirst, fontname="Microsoft YaHei", fontsize=22];
node [fontname="Microsoft YaHei", fontsize=12, color="#38536b", penwidth=1.15];
edge [fontname="Microsoft YaHei", fontsize=10, color="#6e8599", fontcolor="#38536b", arrowsize=0.65, penwidth=1.0, labeldistance=1.8];
"E1" [shape=box, style="filled", fillcolor="#eaf1f8", width=2.2, margin="0.16,0.14", label="E1\n学生用户"];
"E4" [shape=box, style="filled", fillcolor="#eaf1f8", width=2.2, margin="0.16,0.14", label="E4\n腾讯云 OCR"];
"E5" [shape=box, style="filled", fillcolor="#eaf1f8", width=2.2, margin="0.16,0.14", label="E5\nDeepSeek"];
"P2.1" [shape=box, style="rounded,filled", fillcolor="#e4f3ec", color="#286b54", width=2.4, margin="0.18,0.16", label="P2.1\n接收并校验\n草稿与原件"];
"P2.2" [shape=box, style="rounded,filled", fillcolor="#e4f3ec", color="#286b54", width=2.4, margin="0.18,0.16", label="P2.2\n获取文字与\n印章定位结果"];
"P2.3" [shape=box, style="rounded,filled", fillcolor="#e4f3ec", color="#286b54", width=2.4, margin="0.18,0.16", label="P2.3\n形成计分与\n活动匹配建议"];
"P2.4" [shape=box, style="rounded,filled", fillcolor="#e4f3ec", color="#286b54", width=2.4, margin="0.18,0.16", label="P2.4\n接收学生确认\n与手动补填截图"];
"P2.5" [shape=box, style="rounded,filled", fillcolor="#e4f3ec", color="#286b54", width=2.4, margin="0.18,0.16", label="P2.5\n保存草稿版本\n及证据关联"];
"D1" [shape=plain, margin=0, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#8b754b"><TR><TD BORDER="1" SIDES="LRTB" BGCOLOR="#fff3d8">D1</TD><TD WIDTH="180" BORDER="1" SIDES="TB" BGCOLOR="#fff3d8">账号、角色与组织权限</TD></TR></TABLE>>];
"D2" [shape=plain, margin=0, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#8b754b"><TR><TD BORDER="1" SIDES="LRTB" BGCOLOR="#fff3d8">D2</TD><TD WIDTH="180" BORDER="1" SIDES="TB" BGCOLOR="#fff3d8">学年与评分标准</TD></TR></TABLE>>];
"D3" [shape=plain, margin=0, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#8b754b"><TR><TD BORDER="1" SIDES="LRTB" BGCOLOR="#fff3d8">D3</TD><TD WIDTH="180" BORDER="1" SIDES="TB" BGCOLOR="#fff3d8">申请、版本与提交轮次</TD></TR></TABLE>>];
"D4" [shape=plain, margin=0, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#8b754b"><TR><TD BORDER="1" SIDES="LRTB" BGCOLOR="#fff3d8">D4</TD><TD WIDTH="180" BORDER="1" SIDES="TB" BGCOLOR="#fff3d8">原文件与关键证据</TD></TR></TABLE>>];
