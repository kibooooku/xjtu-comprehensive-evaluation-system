digraph CurrentDesign {
graph [rankdir=TB,bgcolor="white",pad="0.36",nodesep="0.55",ranksep="1.18",splines=polyline,overlap=false,outputorder=edgesfirst,fontname="Arial",fontsize=12];
node [shape=plain,fontname="Arial",fontsize=12,margin=0];
edge [fontname="Arial",fontsize=10,color="#7b8e9f",fontcolor="#334c62",arrowsize=0.7,penwidth=1.1,labeldistance=2.0];
"Enrollment" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#697d8e"><TR><TD WIDTH="400" BGCOLOR="#697d8e"><FONT COLOR="white" POINT-SIZE="11">«reference»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>Enrollment</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">学年归属</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− id: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− studentId / classYearId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: enrollments</FONT></TD></TR></TABLE>>];
"ScoreCategory" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#697d8e"><TR><TD WIDTH="400" BGCOLOR="#697d8e"><FONT COLOR="white" POINT-SIZE="11">«reference»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>ScoreCategory</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">加分类别</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− id / code: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− defaultCap: Decimal</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: score_categories</FONT></TD></TR></TABLE>>];
"CategorySubmission" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#285c84"><TR><TD WIDTH="400" BGCOLOR="#285c84"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>CategorySubmission</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">大类申报</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− id: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− enrollmentId / categoryId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− createdAt / updatedAt</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: category_submissions</FONT></TD></TR></TABLE>>];
"CategoryItem" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#285c84"><TR><TD WIDTH="400" BGCOLOR="#285c84"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>CategoryItem</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">加分小项映射</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− submissionId / applicationId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− sortOrder: Integer</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− confirmedAt / deletedAt: DateTime?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: category_items</FONT></TD></TR></TABLE>>];
"Application" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#285c84"><TR><TD WIDTH="400" BGCOLOR="#285c84"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>Application</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">小项稳定身份</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− id: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− workingRevisionId: UUID?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− currentRoundId: UUID?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− lockVersion: Integer</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: applications</FONT></TD></TR></TABLE>>];
"ApplicationRevision" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#285c84"><TR><TD WIDTH="400" BGCOLOR="#285c84"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>ApplicationRevision</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">内容版本</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− id / revisionNo</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− title: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− requestedScore: Decimal(6,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− payloadJson: JSON</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− contentFrozenAt: DateTime?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: application_revisions</FONT></TD></TR></TABLE>>];
"SubmissionRound" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#285c84"><TR><TD WIDTH="400" BGCOLOR="#285c84"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>SubmissionRound</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">提审轮次</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− applicationId / revisionId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− roundNo / lockVersion: Integer</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− state: RoundState</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− eligibilityVersionId: UUID?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: submission_rounds</FONT></TD></TR></TABLE>>];
"ReviewDecision" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#285c84"><TR><TD WIDTH="400" BGCOLOR="#285c84"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>ReviewDecision</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">人工决定</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− roundId / revisionId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− actorId / roleAssignmentId</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− stage / action</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− idempotencyKey / decidedAt</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: review_decisions</FONT></TD></TR></TABLE>>];
"ApplicationEvent" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#285c84"><TR><TD WIDTH="400" BGCOLOR="#285c84"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>ApplicationEvent</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">操作历史</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− applicationId / eventNo</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− roundId / revisionId: UUID?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− eventType / fromState / toState</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− actorId / detailJson / occurredAt</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: application_events</FONT></TD></TR></TABLE>>];
"User" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#697d8e"><TR><TD WIDTH="400" BGCOLOR="#697d8e"><FONT COLOR="white" POINT-SIZE="11">«reference»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>User</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">操作人</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− id: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− baseIdentity: IdentityKind</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: users</FONT></TD></TR></TABLE>>];
"WorkflowService" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#725096"><TR><TD WIDTH="400" BGCOLOR="#725096"><FONT COLOR="white" POINT-SIZE="11">«service»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>WorkflowService</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">小项工作流</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− expectedVersionGuard</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− publicity / classReadyGuard</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f1edf7"><FONT POINT-SIZE="12">+ update_application(expected_version)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f1edf7"><FONT POINT-SIZE="12">+ submit_application / submit_items</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f1edf7"><FONT POINT-SIZE="12">+ review_application / withdraw_application</FONT></TD></TR></TABLE>>];
"ActivityEligibilityService" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#697d8e"><TR><TD WIDTH="400" BGCOLOR="#697d8e"><FONT COLOR="white" POINT-SIZE="11">«reference»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>ActivityEligibilityService</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">活动资格</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− activity / category / year</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f1edf7"><FONT POINT-SIZE="12">+ activity_eligibility(...)</FONT></TD></TR></TABLE>>];
"Enrollment" -> "CategorySubmission" [id="e0",label="每学年、每大类一份",dir=both,arrowhead=none,arrowtail=none,taillabel="1",headlabel="0..*"];
"ScoreCategory" -> "CategorySubmission" [id="e1",label="按类别归组",dir=both,arrowhead=none,arrowtail=none,taillabel="1",headlabel="0..*"];
"CategorySubmission" -> "CategoryItem" [id="e2",label="包含小项",dir=both,arrowhead=none,arrowtail=diamond,taillabel="1",headlabel="0..*"];
"CategoryItem" -> "Application" [id="e3",label="一一对应",dir=both,arrowhead=none,arrowtail=none,taillabel="1",headlabel="1"];
"Application" -> "ApplicationRevision" [id="e4",label="修订与冻结版本",dir=both,arrowhead=none,arrowtail=diamond,taillabel="1",headlabel="1..*"];
"Application" -> "SubmissionRound" [id="e5",label="各次提审",dir=both,arrowhead=none,arrowtail=diamond,taillabel="1",headlabel="0..*"];
"ApplicationRevision" -> "SubmissionRound" [id="e6",label="绑定确切内容版本",dir=both,arrowhead=none,arrowtail=none,taillabel="1",headlabel="0..*"];
"SubmissionRound" -> "ReviewDecision" [id="e7",label="学生初审 / 辅导员审查",dir=both,arrowhead=none,arrowtail=diamond,taillabel="1",headlabel="0..*"];
"Application" -> "ApplicationEvent" [id="e8",label="完整业务历史",dir=both,arrowhead=none,arrowtail=diamond,taillabel="1",headlabel="0..*"];
"User" -> "ReviewDecision" [id="e9",label="经办人与角色快照",dir=both,arrowhead=none,arrowtail=none,taillabel="1",headlabel="0..*"];
"WorkflowService" -> "Application" [id="e10",label="版本校验与直接提交",style=dashed,arrowhead=vee,color="#927ba8"];
"WorkflowService" -> "SubmissionRound" [id="e11",label="状态推进 / 通过锁定",style=dashed,arrowhead=vee,color="#927ba8"];
"WorkflowService" -> "ActivityEligibilityService" [id="e12",label="仅三类需要资格",style=dashed,arrowhead=vee,color="#927ba8"];
}