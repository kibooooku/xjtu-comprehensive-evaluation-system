digraph CurrentDesign {
graph [rankdir=TB,bgcolor="white",pad="0.36",nodesep="0.55",ranksep="1.18",splines=polyline,overlap=false,outputorder=edgesfirst,fontname="Arial",fontsize=12];
node [shape=plain,fontname="Arial",fontsize=12,margin=0];
edge [fontname="Arial",fontsize=10,color="#7b8e9f",fontcolor="#334c62",arrowsize=0.7,penwidth=1.1,labeldistance=2.0];
"User" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#285c84"><TR><TD WIDTH="400" BGCOLOR="#285c84"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>User</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">用户</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− id: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− username / displayName: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− baseIdentity: IdentityKind</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− status: ACTIVE | DISABLED | DELETED</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: users</FONT></TD></TR></TABLE>>];
"StudentProfile" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#285c84"><TR><TD WIDTH="400" BGCOLOR="#285c84"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>StudentProfile</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">学生档案</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− id / userId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− studentNumber: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− profileStatus: ProfileStatus</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: student_profiles</FONT></TD></TR></TABLE>>];
"TeachingClass" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#285c84"><TR><TD WIDTH="400" BGCOLOR="#285c84"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>TeachingClass</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">教学班</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− id: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− code / name: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− status: ACTIVE | SETUP</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: classes</FONT></TD></TR></TABLE>>];
"AcademicYear" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#285c84"><TR><TD WIDTH="400" BGCOLOR="#285c84"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>AcademicYear</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">学年</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− id: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− code / name: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− isSelectable: Boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: academic_years</FONT></TD></TR></TABLE>>];
"ClassYear" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#285c84"><TR><TD WIDTH="400" BGCOLOR="#285c84"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>ClassYear</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">班级学年</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− id: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− classId / academicYearId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− scoreRuleVersionId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− lockVersion: Integer</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: class_years</FONT></TD></TR></TABLE>>];
"Enrollment" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#285c84"><TR><TD WIDTH="400" BGCOLOR="#285c84"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>Enrollment</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">学生学年归属</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− id: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− studentId / classYearId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− status / recordedAt</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: enrollments</FONT></TD></TR></TABLE>>];
"Role" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#285c84"><TR><TD WIDTH="400" BGCOLOR="#285c84"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>Role</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">角色</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− id / code: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− allowedIdentity: IdentityKind</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− scopeKind: GLOBAL | CLASS</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: roles</FONT></TD></TR></TABLE>>];
"Permission" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#285c84"><TR><TD WIDTH="400" BGCOLOR="#285c84"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>Permission</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">资源操作</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− id / code: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− module / action: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: permissions</FONT></TD></TR></TABLE>>];
"RolePermission" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#285c84"><TR><TD WIDTH="400" BGCOLOR="#285c84"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>RolePermission</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">权限矩阵</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− roleId / permissionId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− isAllowed: Boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− dataScope: DataScope</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: role_permissions</FONT></TD></TR></TABLE>>];
"RoleAssignment" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#285c84"><TR><TD WIDTH="400" BGCOLOR="#285c84"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>RoleAssignment</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">角色授权</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− userId / roleId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− classId: UUID?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− validFrom / validTo</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− status: GrantStatus</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: role_assignments</FONT></TD></TR></TABLE>>];
"CounselorClassAssignment" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#285c84"><TR><TD WIDTH="400" BGCOLOR="#285c84"><FONT COLOR="white" POINT-SIZE="11">«entity»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>CounselorClassAssignment</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">带班关系</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− counselorId / classId: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− validFrom / validTo</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− status: GrantStatus</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf3f7"><FONT COLOR="#526b7d" POINT-SIZE="10">table: counselor_classes</FONT></TD></TR></TABLE>>];
"AuthorizationService" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#725096"><TR><TD WIDTH="400" BGCOLOR="#725096"><FONT COLOR="white" POINT-SIZE="11">«service»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>AuthorizationService</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">授权服务</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− mandatoryIdentityRules</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f5f8fb"><FONT POINT-SIZE="12">− scopeIntersectionRules</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f1edf7"><FONT POINT-SIZE="12">+ active_grants(user)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f1edf7"><FONT POINT-SIZE="12">+ allowed(permission, class, owner)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f1edf7"><FONT POINT-SIZE="12">+ require(permission, class, owner)</FONT></TD></TR></TABLE>>];
"UserAdministrationService" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#725096"><TR><TD WIDTH="400" BGCOLOR="#725096"><FONT COLOR="white" POINT-SIZE="11">«service»</FONT><BR/><FONT COLOR="white" POINT-SIZE="16"><B>UserAdministrationService</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="13">学生账号管理</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BGCOLOR="#f1edf7"><FONT POINT-SIZE="12">+ delete_student_account(target_id, actor)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f1edf7"><FONT POINT-SIZE="12">+ backup / archive_usage / preserve_audit</FONT></TD></TR></TABLE>>];
